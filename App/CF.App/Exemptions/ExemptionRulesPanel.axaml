<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:parts="using:CF.App.Parts"
             xmlns:screen="using:CF.App.Exemptions"
             x:Class="CF.App.Exemptions.ExemptionRulesPanel"
             x:ClassModifier="internal"
             x:DataType="screen:ExemptionsViewModel">

  <!-- The panel "By rule": the key at its top, then a row for each rule. Beside the files from 1304 wide; in one pane it stands in the
       page as one line, "By rule", the number of rules and a small "Show". The rules are one tab stop; Up and Down move between them. -->
  <UserControl.Styles>
    <Style Selector="Button.exrule">
      <Setter Property="Padding" Value="10,9,12,9"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border Name="Surface" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch"/>
            </Border>
            <Border Name="Here" IsVisible="False" IsHitTestVisible="False" Width="4" CornerRadius="2" HorizontalAlignment="Left"
                    Margin="0,10" Background="{DynamicResource here}"/>
            <Border Name="Ring" IsVisible="False" IsHitTestVisible="False" CornerRadius="12" BorderThickness="2"
                    BorderBrush="{DynamicResource focus}"/>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.exrule:pointerover /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource hover}"/>
    </Style>
    <Style Selector="Button.exrule:pressed /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource line}"/>
    </Style>
    <Style Selector="Button.exrule:focus-visible /template/ Border#Ring">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Button.exrule.chosen /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource page}"/>
      <Setter Property="BoxShadow" Value="{DynamicResource shadow-raised}"/>
    </Style>
    <Style Selector="Button.exrule.chosen /template/ Border#Here">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Button.exrule.chosen TextBlock.title">
      <Setter Property="FontWeight" Value="600"/>
    </Style>
    <Style Selector="Button.exrule screen|ExemptionBar">
      <Setter Property="Fill" Value="{DynamicResource data}"/>
    </Style>
    <Style Selector="Button.exrule.back screen|ExemptionBar">
      <Setter Property="Thickness" Value="4"/>
      <Setter Property="Fill" Value="{DynamicResource line-strong}"/>
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource side}" CornerRadius="16" Padding="8,12,8,8">
    <StackPanel Name="RulePanel">

      <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,0,0,8" MinHeight="28">
        <TextBlock Theme="{StaticResource type-h3}" VerticalAlignment="Center" Text="By rule"/>
        <TextBlock Grid.Column="1" Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}" Margin="10,2,8,0" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Text="{Binding RulesHead}"/>
        <Button Grid.Column="2" Name="PanelToggleButton" Classes="cf quiet small" IsVisible="{Binding IsOnePane}" VerticalAlignment="Center"
                Command="{Binding TogglePanelCommand}" AutomationProperties.Name="{Binding PanelToggleText, StringFormat='{}{0} the count by rule'}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Theme="{StaticResource type-meta-strong}" Text="{Binding PanelToggleText}"/>
            <parts:Icon Data="{StaticResource i-down}" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>

      <!-- The key: what the colours and the two marks of the rows mean. -->
      <WrapPanel Name="KeyRow" IsVisible="{Binding PanelIsListed}" Margin="10,0,4,8" ItemSpacing="16" LineSpacing="4" Orientation="Horizontal">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Border Width="12" Height="8" CornerRadius="2" Background="{DynamicResource data}" VerticalAlignment="Center"/>
          <TextBlock Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}" Text="With a reason"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Border Width="12" Height="8" CornerRadius="2" Background="{DynamicResource block}" VerticalAlignment="Center"/>
          <TextBlock Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}" Text="Without a reason"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <parts:Icon Data="{StaticResource i-pen}" Width="13" Height="13" Stroke="{DynamicResource ink-3}" VerticalAlignment="Center"/>
          <TextBlock Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}" Text="Custom rule"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <parts:Icon Data="{StaticResource i-file}" Width="13" Height="13" Stroke="{DynamicResource ink-3}" VerticalAlignment="Center"/>
          <TextBlock Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}" Text="Rule of .editorconfig"/>
        </StackPanel>
      </WrapPanel>

      <ItemsControl Name="RuleList" ItemsSource="{Binding RuleRows}" IsVisible="{Binding PanelIsListed}" KeyboardNavigation.TabNavigation="Once">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="2"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="screen:ExemptionRuleRowViewModel" x:DataType="screen:ExemptionRuleRowViewModel">
            <Button Classes="exrule" Classes.chosen="{Binding IsChosen}" Classes.back="{Binding IsSteppedBack}"
                    Command="{Binding ChooseCommand}" AutomationProperties.Name="{Binding SpokenName}">
              <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                <parts:Icon IsVisible="{Binding IsCustom}" Data="{StaticResource i-pen}" Width="15" Height="15" Stroke="{DynamicResource ink-3}"
                            VerticalAlignment="Top" Margin="0,3,0,0"/>
                <parts:Icon IsVisible="{Binding IsFromFile}" Data="{StaticResource i-file}" Width="15" Height="15" Stroke="{DynamicResource ink-3}"
                            VerticalAlignment="Top" Margin="0,3,0,0"/>
                <TextBlock Grid.Column="1" Classes="title" Theme="{StaticResource type-body-strong}" TextWrapping="Wrap" Text="{Binding Title}"/>
                <TextBlock Grid.Column="2" Classes="number" Theme="{StaticResource type-card}" FontFeatures="+tnum" MinWidth="24" TextAlignment="Right" Text="{Binding CountText}"/>
                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto" Height="18" Margin="0,3,0,0">
                  <TextBlock IsVisible="{Binding ShowsId}" Theme="{StaticResource code}" Foreground="{DynamicResource ink-2}" MinWidth="58" VerticalAlignment="Center" Text="{Binding RuleId}"/>
                  <screen:ExemptionBar Grid.Column="1" Margin="10,0,0,0" Fraction="{Binding Fraction}" RedFraction="{Binding RedFraction}"
                                       RedFill="{DynamicResource block}"/>
                  <TextBlock Grid.Column="2" IsVisible="{Binding HasWithoutReason}" Margin="10,0,0,0" Theme="{StaticResource type-meta}" FontWeight="600"
                             Foreground="{DynamicResource block-ink}" VerticalAlignment="Center" Text="{Binding WithoutReasonText}"/>
                </Grid>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </Border>

</UserControl>
