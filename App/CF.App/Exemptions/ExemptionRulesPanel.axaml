<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:parts="using:CF.App.Parts"
             xmlns:screen="using:CF.App.Exemptions"
             x:Class="CF.App.Exemptions.ExemptionRulesPanel"
             x:ClassModifier="internal"
             x:DataType="screen:ExemptionsViewModel">

  <!-- The panel "By rule": the rules grouped by source. Beside the files from 1304 wide; in one pane it stands in the
       page as one line, "By rule", the number of rules and a small "Show". The rules are one tab stop; Up and Down move between them. -->
  <UserControl.Styles>
    <Style Selector="Border.exrule-group.following">
      <!-- The list's 2-pixel spacing supplies the rest of the gap. -->
      <Setter Property="Margin" Value="0,14,0,0"/>
    </Style>
    <Style Selector="Button.exrule">
      <Setter Property="Padding" Value="29,9,12,9"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border Name="Surface" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch"/>
            </Border>
            <Border Name="Here" IsVisible="False" IsHitTestVisible="False" Width="4" CornerRadius="2" HorizontalAlignment="Left"
                    Margin="0,10" Background="{DynamicResource here}"/>
            <Border Name="Ring" IsVisible="False" IsHitTestVisible="False" CornerRadius="12" BorderThickness="2"
                    BorderBrush="{DynamicResource focus}"/>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.exrule:pointerover /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource hover}"/>
    </Style>
    <Style Selector="Button.exrule:pressed /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource line}"/>
    </Style>
    <Style Selector="Button.exrule:focus-visible /template/ Border#Ring">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Button.exrule.chosen /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource page}"/>
      <Setter Property="BoxShadow" Value="{DynamicResource shadow-raised}"/>
    </Style>
    <Style Selector="Button.exrule.chosen /template/ Border#Here">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Button.exrule.chosen TextBlock.title">
      <Setter Property="FontWeight" Value="600"/>
    </Style>
    <Style Selector="Button.exrule screen|ExemptionBar">
      <Setter Property="Fill" Value="{DynamicResource data}"/>
    </Style>
    <Style Selector="Button.exrule.back screen|ExemptionBar">
      <Setter Property="Thickness" Value="4"/>
      <Setter Property="Fill" Value="{DynamicResource line-strong}"/>
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource side}" CornerRadius="16" Padding="8,12,8,8">
    <StackPanel Name="RulePanel">

      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="4,0,0,8" MinHeight="28">
        <TextBlock Theme="{StaticResource type-h3}" VerticalAlignment="Center" Text="By rule"/>
        <TextBlock Grid.Column="1" Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}" Margin="10,2,8,0" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Text="{Binding RulesHead}"/>
        <TextBlock Grid.Column="2" IsVisible="{Binding PanelIsListed}" Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}"
                   Margin="0,0,12,0" VerticalAlignment="Center" Text="Exemptions" AutomationProperties.AccessibilityView="Raw"/>
        <Button Grid.Column="3" Name="PanelToggleButton" Classes="cf quiet small" IsVisible="{Binding IsOnePane}" VerticalAlignment="Center"
                Command="{Binding TogglePanelCommand}" AutomationProperties.Name="{Binding PanelToggleText, StringFormat='{}{0} the count by rule'}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Theme="{StaticResource type-meta-strong}" Text="{Binding PanelToggleText}"/>
            <parts:Icon Data="{StaticResource i-down}" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>

      <ItemsControl Name="RuleList" ItemsSource="{Binding RulePanelItems}" IsVisible="{Binding PanelIsListed}"
                    Grid.IsSharedSizeScope="True" KeyboardNavigation.TabNavigation="Once">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="2"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.DataTemplates>
          <DataTemplate DataType="screen:ExemptionRuleGroupHeading" x:DataType="screen:ExemptionRuleGroupHeading">
            <Border Classes="exrule-group" Classes.following="{Binding FollowsGroup}" Padding="10,0,4,6">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <parts:Icon IsVisible="{Binding IsCustom}" Data="{StaticResource i-pen}" Width="13" Height="13"
                            Stroke="{DynamicResource ink-3}" VerticalAlignment="Center"/>
                <parts:Icon IsVisible="{Binding IsFromFile}" Data="{StaticResource i-file}" Width="13" Height="13"
                            Stroke="{DynamicResource ink-3}" VerticalAlignment="Center"/>
                <TextBlock Theme="{StaticResource type-meta-strong}" Foreground="{DynamicResource ink-2}" Text="{Binding Title}"
                           AutomationProperties.HeadingLevel="3" AutomationProperties.Name="{Binding SpokenName}"/>
                <TextBlock Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-3}" FontFeatures="+tnum" Text="{Binding CountText}"
                           AutomationProperties.AccessibilityView="Raw"/>
              </StackPanel>
            </Border>
          </DataTemplate>
          <DataTemplate DataType="screen:ExemptionRuleRowViewModel" x:DataType="screen:ExemptionRuleRowViewModel">
            <Button Classes="exrule" Classes.chosen="{Binding IsChosen}" Classes.back="{Binding IsSteppedBack}"
                    Command="{Binding ChooseCommand}" AutomationProperties.Name="{Binding SpokenName}">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                <TextBlock Classes="title" Theme="{StaticResource type-body-strong}" TextWrapping="Wrap" Text="{Binding Title}"/>
                <TextBlock Grid.Column="1" Classes="number" Theme="{StaticResource type-card}" FontFeatures="+tnum" MinWidth="24" TextAlignment="Right" Text="{Binding CountText}"/>
                <Grid Grid.Row="1" Grid.ColumnSpan="2" RowDefinitions="18,Auto" ColumnSpacing="10" Margin="0,3,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="58" SharedSizeGroup="RuleId"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock IsVisible="{Binding ShowsId}" Theme="{StaticResource code}" Foreground="{DynamicResource ink-2}" VerticalAlignment="Center" Text="{Binding RuleId}"/>
                  <screen:ExemptionBar Grid.Column="1" Fraction="{Binding Fraction}" RedFraction="{Binding RedFraction}"
                                       RedFill="{DynamicResource block}"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" IsVisible="{Binding HasWithoutReason}" Margin="0,2,0,0" Theme="{StaticResource type-meta}"
                             FontWeight="600" Foreground="{DynamicResource block-ink}" Text="{Binding WithoutReasonText}"/>
                </Grid>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.DataTemplates>
      </ItemsControl>

    </StackPanel>
  </Border>

</UserControl>
