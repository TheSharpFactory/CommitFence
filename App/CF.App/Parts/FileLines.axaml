<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:parts="using:CF.App.Parts"
             x:Class="CF.App.Parts.FileLines"
             x:ClassModifier="internal">

  <!-- The lines of a file: one row per line, rows 20 high at least, in code. A number column (52 wide and 16 to its right on the
       page of a file rule, 44 and 14 on Exemptions), right-aligned, in ink-3. The line in force is marked: a bar 4 wide in here at
       the left edge, its number and text in ink at weight 600, and (when the box bands it) the row's background hover. A line that does
       not fit wraps, its rest set in 4 characters; nothing is cut. -->
  <UserControl.Styles>
    <Style Selector="parts|FileLines Border.fileline.current.band">
      <Setter Property="Background" Value="{DynamicResource hover}"/>
    </Style>
    <Style Selector="parts|FileLines Border.fileline.finding">
      <Setter Property="Background" Value="{DynamicResource diff-del}"/>
    </Style>
    <Style Selector="parts|FileLines Border.fileline.moved">
      <Setter Property="Background" Value="{DynamicResource diff-add-mark}"/>
    </Style>
    <Style Selector="parts|FileLines Border.fileline.added">
      <Setter Property="Background" Value="{DynamicResource diff-add}"/>
    </Style>
    <Style Selector="parts|FileLines Border.fileline Border.bar">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="parts|FileLines Border.fileline.current Border.bar">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="parts|FileLines Border.fileline TextBlock.number">
      <Setter Property="Foreground" Value="{DynamicResource ink-3}"/>
    </Style>
    <Style Selector="parts|FileLines Border.fileline :is(TextBlock).text">
      <Setter Property="Foreground" Value="{DynamicResource ink-3}"/>
    </Style>
    <Style Selector="parts|FileLines Border.fileline :is(TextBlock).text.colored">
      <Setter Property="Foreground" Value="{DynamicResource ink}"/>
    </Style>
    <Style Selector="parts|FileLines Border.fileline :is(TextBlock).text.context">
      <Setter Property="Foreground" Value="{DynamicResource ink-2}"/>
    </Style>
    <Style Selector="parts|FileLines Border.fileline :is(TextBlock).text.comment">
      <Setter Property="Foreground" Value="{DynamicResource code-comment}"/>
    </Style>
    <Style Selector="parts|FileLines Border.fileline.current TextBlock.number">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource ink}"/>
    </Style>
    <Style Selector="parts|FileLines Border.fileline.current :is(TextBlock).text">
      <Setter Property="Foreground" Value="{DynamicResource ink}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </UserControl.Styles>

  <ItemsControl Name="Rows">
    <ItemsControl.ItemTemplate>
      <DataTemplate DataType="parts:FileLineViewModel" x:DataType="parts:FileLineViewModel">
        <Border Classes="fileline" Classes.current="{Binding IsCurrent}"
                Classes.band="{Binding $parent[parts:FileLines].BandsCurrent}" Classes.finding="{Binding IsFinding}" Classes.moved="{Binding IsMoved}" Classes.added="{Binding IsAdded}"
                MinHeight="20" IsVisible="{Binding IsPresent}" AutomationProperties.Name="{Binding SpokenName}">
          <Panel>
            <Border Classes="bar" Width="4" CornerRadius="2" HorizontalAlignment="Left" Background="{DynamicResource here}"/>
            <Border Width="3" HorizontalAlignment="Left" Background="{DynamicResource block}" IsVisible="{Binding IsFinding}"/>
            <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,0,12,0">
              <Border Width="{Binding $parent[parts:FileLines].NumberWidth}" VerticalAlignment="Top">
                <TextBlock Classes="number" Theme="{StaticResource code}" HorizontalAlignment="Right"
                           Margin="{Binding $parent[parts:FileLines].NumberMargin}" IsVisible="{Binding HasNumber}" Text="{Binding Number}"/>
              </Border>
              <Border Grid.Column="1" Width="{Binding $parent[parts:FileLines].SignWidth}" VerticalAlignment="Top">
                <TextBlock IsVisible="{Binding ShowsPlus}" Text="+" Theme="{StaticResource code-strong}"
                           Foreground="{DynamicResource req-ink}" HorizontalAlignment="Center"/>
              </Border>
              <parts:HangingText Grid.Column="2" Classes="text" Classes.context="{Binding IsHeaderOrGap}" Classes.comment="{Binding IsComment}"
                                 Classes.colored="{Binding IsColored}" Theme="{StaticResource code}"
                                 Margin="{Binding $parent[parts:FileLines].GapMargin}" Line="{Binding Text}" Segments="{Binding Segments}"/>
            </Grid>
          </Panel>
        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>

</UserControl>
