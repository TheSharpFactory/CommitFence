<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:review="using:CF.App.Review"
             xmlns:parts="using:CF.App.Parts"
             x:Class="CF.App.Review.CopyButton"
             x:ClassModifier="internal"
             x:DataType="review:CopyButtonViewModel">

  <!-- A button that puts text on the clipboard. After a click the icon is a tick and the label reads "Copied"
       until the view model says it is time to return. Both labels stand in one place and the one at rest keeps the room, so the
       button never changes its width. -->
  <UserControl.Styles>
    <Style Selector="Button.cf TextBlock">
      <Setter Property="Theme" Value="{StaticResource type-body-strong}"/>
    </Style>
    <Style Selector="Button.cf parts|Icon">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
    </Style>
    <Style Selector="Button.cf.small TextBlock">
      <Setter Property="Theme" Value="{StaticResource type-meta-strong}"/>
    </Style>
    <Style Selector="Button.cf.small parts|Icon">
      <Setter Property="Width" Value="14"/>
      <Setter Property="Height" Value="14"/>
    </Style>
  </UserControl.Styles>
  <Button Classes="cf" Classes.small="{Binding $parent[review:CopyButton].IsCompact}" Classes.main="{Binding IsPrimary}" Classes.outlined="{Binding !IsPrimary}" Command="{Binding CopyCommand}" AutomationProperties.Name="{Binding SpokenName}">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Panel>
        <parts:Icon Data="{StaticResource i-copy}" Stroke="{Binding $parent[Button].Foreground}" IsVisible="{Binding !IsCopied}"/>
        <parts:Icon Data="{StaticResource i-check}" Stroke="{Binding $parent[Button].Foreground}" IsVisible="{Binding IsCopied}"/>
      </Panel>
      <Panel>
        <TextBlock Opacity="{Binding IsCopied, Converter={x:Static review:CopyButton.Hidden}}" Text="{Binding Label}"/>
        <TextBlock HorizontalAlignment="Left" IsVisible="{Binding IsCopied}" Text="Copied"/>
      </Panel>
    </StackPanel>
  </Button>

</UserControl>