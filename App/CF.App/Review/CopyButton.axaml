<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:review="using:CF.App.Review"
             xmlns:parts="using:CF.App.Parts"
             x:Class="CF.App.Review.CopyButton"
             x:ClassModifier="internal"
             x:DataType="review:CopyButtonViewModel">

  <!-- A button that puts text on the clipboard. After a click the icon is a tick and the label reads "Copied"
       until the view model says it is time to return. Both labels stand in one place and the one at rest keeps the room, so the
       button never changes its width. -->
  <Button Classes="cf" Classes.main="{Binding IsPrimary}" Classes.outlined="{Binding !IsPrimary}" Command="{Binding CopyCommand}" AutomationProperties.Name="{Binding SpokenName}">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Panel>
        <parts:Icon Data="{StaticResource i-copy}" Width="16" Height="16" Stroke="{Binding $parent[Button].Foreground}" IsVisible="{Binding !IsCopied}"/>
        <parts:Icon Data="{StaticResource i-check}" Width="16" Height="16" Stroke="{Binding $parent[Button].Foreground}" IsVisible="{Binding IsCopied}"/>
      </Panel>
      <Panel>
        <TextBlock Theme="{StaticResource type-body-strong}" Opacity="{Binding IsCopied, Converter={x:Static review:CopyButton.Hidden}}" Text="{Binding Label}"/>
        <TextBlock Theme="{StaticResource type-body-strong}" HorizontalAlignment="Left" IsVisible="{Binding IsCopied}" Text="Copied"/>
      </Panel>
    </StackPanel>
  </Button>

</UserControl>