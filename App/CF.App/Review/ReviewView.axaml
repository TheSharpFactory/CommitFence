<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:review="using:CF.App.Review"
             xmlns:parts="using:CF.App.Parts"
             xmlns:sys="using:System"
             x:Class="CF.App.Review.ReviewView"
             x:ClassModifier="internal"
             x:DataType="review:ReviewViewModel">

  <!-- The Review screen for the changes a push would send: the title
       strip, the review bar that does not scroll, and the sheet. From 1304 wide the sheet is two columns 32 apart, the main
       column and the panel of the push's files, which stays in view; under 1304 it is one column of at most 760 with the panel
       as one line. A folder is not reviewed yet: its segment is drawn and disabled. -->
  <UserControl.Styles>
    <Style Selector="Run.scope.pattern">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
    </Style>

    <Style Selector="review|ReviewView Border.pagerow">
      <Setter Property="Padding" Value="32,0,20,0"/>
    </Style>
    <Style Selector="review|ReviewView.onepane Border.pagerow">
      <Setter Property="Padding" Value="24,0,12,0"/>
    </Style>
    <Style Selector="review|ReviewView Border.pageframe">
      <Setter Property="MaxWidth" Value="1292"/>
    </Style>
    <Style Selector="review|ReviewView Border.pagecolumn">
      <Setter Property="MaxWidth" Value="1292"/>
      <Setter Property="Padding" Value="0,0,372,0"/>
    </Style>
    <Style Selector="review|ReviewView.onepane Border.pagecolumn">
      <Setter Property="MaxWidth" Value="760"/>
      <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="review|ReviewView Button.fileline">
      <Setter Property="Height" Value="44"/>
      <Setter Property="Padding" Value="8,0,12,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
            </Border>
            <Border Name="Ring" IsVisible="False" IsHitTestVisible="False" CornerRadius="8" BorderThickness="2"
                    BorderBrush="{DynamicResource focus}"/>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="review|ReviewView Button.fileline:pointerover /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource well}"/>
    </Style>
    <Style Selector="review|ReviewView Button.fileline:pressed /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource hover}"/>
    </Style>
    <Style Selector="review|ReviewView Button.fileline:focus-visible /template/ Border#Ring">
      <Setter Property="IsVisible" Value="True"/>
    </Style>

    <Style Selector="review|ReviewView Button.findinghead">
      <Setter Property="Padding" Value="8,11,12,11"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch"/>
            </Border>
            <Border Name="Ring" IsVisible="False" IsHitTestVisible="False" CornerRadius="8" BorderThickness="2"
                    BorderBrush="{DynamicResource focus}"/>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="review|ReviewView Button.findinghead:pointerover /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource well}"/>
    </Style>
    <Style Selector="review|ReviewView Button.findinghead:pressed /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource hover}"/>
    </Style>
    <Style Selector="review|ReviewView Button.findinghead:focus-visible /template/ Border#Ring">
      <Setter Property="IsVisible" Value="True"/>
    </Style>

    <Style Selector="review|ReviewView TextBlock.fixedfinding">
      <Setter Property="Foreground" Value="{DynamicResource ink-2}"/>
    </Style>
    <Style Selector="review|ReviewView TextBlock.fixedfinding.message">
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style Selector="review|ReviewView parts|Icon.chevron">
      <Setter Property="RenderTransform" Value="rotate(0deg)"/>
    </Style>
    <Style Selector="review|ReviewView parts|Icon.chevron.open">
      <Setter Property="RenderTransform" Value="rotate(90deg)"/>
    </Style>

    <Style Selector="review|ReviewView Border.badge">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="CornerRadius" Value="13"/>
    </Style>
    <Style Selector="review|ReviewView Border.badge.refused">
      <Setter Property="Background" Value="{DynamicResource block}"/>
    </Style>
    <Style Selector="review|ReviewView Border.badge.allowed">
      <Setter Property="Background" Value="{DynamicResource req-ink}"/>
    </Style>
    <Style Selector="review|ReviewView Border.badge.incomplete">
      <Setter Property="Background" Value="{DynamicResource solid}"/>
    </Style>
    <Style Selector="review|ReviewView Border.badge.folder">
      <Setter Property="Background" Value="{DynamicResource solid}"/>
    </Style>
    <Style Selector="review|ReviewView Border.badge.running">
      <Setter Property="Background" Value="{DynamicResource hover}"/>
    </Style>

    <Style Selector="review|ReviewView Border.piece">
      <Setter Property="Height" Value="34"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="10,0,13,0"/>
    </Style>
    <Style Selector="review|ReviewView Border.piece.block">
      <Setter Property="Background" Value="{DynamicResource block}"/>
    </Style>
    <Style Selector="review|ReviewView Border.piece.warn">
      <Setter Property="Background" Value="{DynamicResource warn}"/>
    </Style>
    <Style Selector="review|ReviewView Border.piece.allow">
      <Setter Property="Background" Value="{DynamicResource req-ink}"/>
    </Style>

    <Style Selector="review|ReviewView StackPanel.reasonbody">
      <Setter Property="Margin" Value="34,2,12,14"/>
    </Style>
    <Style Selector="review|ReviewView.onepane StackPanel.reasonbody">
      <Setter Property="Margin" Value="8,2,12,14"/>
    </Style>

    <Style Selector="review|ReviewView StackPanel.findingbody">
      <Setter Property="Margin" Value="96,2,12,18"/>
    </Style>
    <Style Selector="review|ReviewView StackPanel.findingbody.folder">
      <Setter Property="Margin" Value="120,2,12,18"/>
    </Style>
    <Style Selector="review|ReviewView.onepane StackPanel.findingbody">
      <Setter Property="Margin" Value="8,2,12,18"/>
    </Style>

    <Style Selector="review|ReviewView StackPanel.findingopens">
      <Setter Property="Grid.Column" Value="1"/>
    </Style>
    <Style Selector="review|ReviewView.onepane StackPanel.findingopens">
      <Setter Property="Grid.Column" Value="0"/>
      <Setter Property="Grid.Row" Value="1"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <Style Selector="review|ReviewView Button.pickerentry">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border Name="Surface" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
            </Border>
            <Border Name="Ring" IsVisible="False" IsHitTestVisible="False" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource focus}"/>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="review|ReviewView Button.pickerentry:pointerover /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource hover}"/>
    </Style>
    <Style Selector="review|ReviewView Button.pickerentry:pressed /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource line}"/>
    </Style>
    <Style Selector="review|ReviewView Button.pickerentry:focus-visible /template/ Border#Ring">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="review|ReviewView Button.clearfilter">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7">
              <parts:Icon Data="{StaticResource i-x}" Width="16" Height="16" Stroke="{DynamicResource ink-2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Name="Ring" IsVisible="False" IsHitTestVisible="False" CornerRadius="7" BorderThickness="2" BorderBrush="{DynamicResource focus}"/>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="review|ReviewView Button.clearfilter:pointerover /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource line-strong}"/>
    </Style>
    <Style Selector="review|ReviewView Button.clearfilter:focus-visible /template/ Border#Ring">
      <Setter Property="IsVisible" Value="True"/>
    </Style>

    <Style Selector="review|ReviewView ListBox.segmented ListBoxItem:disabled TextBlock.segment">
      <Setter Property="Foreground" Value="{DynamicResource ink-disabled}"/>
    </Style>

  </UserControl.Styles>

  <Grid RowDefinitions="36,Auto,*" Background="{DynamicResource page}">

    <!-- The review bar: padding 4 above and 12 below, a hairline under it across the page. The word, the choice, and at the
         right end the run button. -->
    <Border Grid.Row="1" BorderBrush="{DynamicResource line}" BorderThickness="0,0,0,1" Padding="32,4,32,12">
      <Border Name="Bar" MaxWidth="1292" HorizontalAlignment="Stretch">
        <Grid Name="BarGrid" ColumnDefinitions="Auto,12,Auto,12,Auto,*,Auto" RowDefinitions="Auto,Auto">
          <TextBlock Theme="{StaticResource type-body}" FontWeight="Medium" VerticalAlignment="Center" Text="Review"/>
          <parts:SegmentedList Grid.Column="2" Classes="segmented" ItemsSource="{Binding Choices}"
                               SelectedItem="{Binding SelectedChoice, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}"
                               AutomationProperties.Name="What to review">
            <parts:SegmentedList.ItemTemplate>
              <DataTemplate DataType="review:ReviewChoiceViewModel" x:DataType="review:ReviewChoiceViewModel">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" AutomationProperties.Name="{Binding SpokenName}">
                  <parts:Icon Data="{StaticResource i-branch}" Width="14" Height="14" Stroke="{DynamicResource ink-2}" IsVisible="{Binding IsChanges}"/>
                  <parts:Icon Data="{StaticResource i-folder}" Width="14" Height="14" Stroke="{DynamicResource ink-2}" IsVisible="{Binding IsFolder}"/>
                  <TextBlock Classes="segment" Theme="{StaticResource type-body}" Text="{Binding Label}"/>
                </StackPanel>
              </DataTemplate>
            </parts:SegmentedList.ItemTemplate>
            <parts:SegmentedList.Styles>
              <Style Selector="ListBoxItem" x:DataType="review:ReviewChoiceViewModel">
                <Setter Property="IsEnabled" Value="{Binding IsAvailable}"/>
              </Style>
            </parts:SegmentedList.Styles>
          </parts:SegmentedList>
          <Button Name="FolderButton" Grid.Column="4" Classes="cf outlined" IsVisible="{Binding IsFolderChosen}" MinWidth="180" MaxWidth="320"
                  HorizontalContentAlignment="Stretch" Padding="12,0,10,0" Command="{Binding TogglePickerCommand}"
                  AutomationProperties.Name="{Binding FolderLabel, StringFormat='{}Folder to review: {0}'}">
            <ToolTip.Tip>
              <TextBlock Text="{Binding FolderPath, StringFormat='{}{0} Choose a folder or a project file'}"/>
            </ToolTip.Tip>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <parts:Icon Data="{StaticResource i-folder}" Width="16" Height="16" Stroke="{DynamicResource ink-3}"/>
              <TextBlock Grid.Column="1" Theme="{StaticResource code}" TextTrimming="PrefixCharacterEllipsis" VerticalAlignment="Center" Text="{Binding FolderLabel}"/>
              <parts:Icon Grid.Column="2" Data="{StaticResource i-down}" Width="13" Height="13" Stroke="{DynamicResource ink-2}"/>
            </Grid>
          </Button>
          <Popup Name="Picker" PlacementTarget="{Binding #FolderButton}" Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True"
                 IsOpen="{Binding PickerOpen, Mode=TwoWay}" VerticalOffset="6">
            <Border Width="340" Background="{DynamicResource page}" BorderBrush="{DynamicResource line}" BorderThickness="1" CornerRadius="12" Padding="6"
                    BoxShadow="{DynamicResource shadow-raised}">
              <StackPanel>
                <ItemsControl ItemsSource="{Binding PickerEntries}" KeyboardNavigation.TabNavigation="Continue">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="review:FolderPickerEntryViewModel" x:DataType="review:FolderPickerEntryViewModel">
                      <StackPanel>
                        <Border IsVisible="{Binding StartsDialogs}" BorderBrush="{DynamicResource line}" BorderThickness="0,1,0,0" Margin="0,4,0,4"/>
                        <Button Classes="pickerentry" Command="{Binding $parent[review:ReviewView].((review:ReviewViewModel)DataContext).PickEntryCommand}"
                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding SpokenName}">
                          <Grid ColumnDefinitions="*,Auto,20" ColumnSpacing="8">
                            <TextBlock Theme="{StaticResource code}" IsVisible="{Binding IsCode}" TextTrimming="PrefixCharacterEllipsis" VerticalAlignment="Center" Text="{Binding Label}"/>
                            <TextBlock Theme="{StaticResource type-body}" IsVisible="{Binding IsWords}" VerticalAlignment="Center" Text="{Binding Label}"/>
                            <TextBlock Grid.Column="1" Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}" VerticalAlignment="Center" Text="{Binding Note}"/>
                            <parts:Icon Grid.Column="2" Data="{StaticResource i-check}" Width="15" Height="15" Stroke="{DynamicResource ink}" IsVisible="{Binding IsTicked}"/>
                          </Grid>
                        </Button>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Popup>
          <Button Name="RunButton" Grid.Column="6" Classes="cf" IsVisible="{Binding ShowsBarRun}" Classes.main="{Binding RunIsMain}" Classes.outlined="{Binding RunIsSecond}"
                  Command="{Binding RunCommand}" AutomationProperties.Name="{Binding RunText}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <parts:Icon Data="{StaticResource i-review}" Width="16" Height="16" Stroke="{Binding $parent[Button].Foreground}"
                          IsVisible="{Binding RunShowsIcon}"/>
              <parts:TurningRing Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding IsBusy}"/>
              <TextBlock Theme="{StaticResource type-body-strong}" Text="{Binding RunText}"/>
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Border>

    <!-- The states before a review: one block across the pane, its middle at 40
         percent of the pane's height and its top at least 32 below the pane's top. Nothing but its button takes the keyboard. -->
    <Panel Name="EmptyBlock" Grid.Row="2" IsVisible="{Binding ShowsEmptyBlock}">
      <StackPanel Name="EmptyBlockBody" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="32,32,32,0">
        <Viewbox Width="56" Height="56" Margin="0,0,0,20" IsVisible="{Binding Verdict.HasEmblem}" Focusable="False">
          <parts:LogoMark/>
        </Viewbox>
        <TextBlock Theme="{StaticResource type-verdict}" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding Verdict.Heading}"/>
        <TextBlock Theme="{StaticResource type-lead}" Foreground="{DynamicResource ink-2}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"
                   IsVisible="{Binding Verdict.HasLead}" Text="{Binding Verdict.Lead}"/>
        <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center" Margin="0,16,0,0" IsVisible="{Binding ShowsRulesLine}">
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasRulesBlock}">
            <parts:EffectMark Classes="block" Kind="Block" Width="15" Height="15" VerticalAlignment="Center"/>
            <TextBlock Theme="{StaticResource type-body}" Foreground="{DynamicResource ink-2}" FontFeatures="+tnum" VerticalAlignment="Center" Text="{Binding RulesBlockText}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasRulesWarn}">
            <parts:EffectMark Classes="warn" Kind="Warn" Width="15" Height="15" VerticalAlignment="Center"/>
            <TextBlock Theme="{StaticResource type-body}" Foreground="{DynamicResource ink-2}" FontFeatures="+tnum" VerticalAlignment="Center" Text="{Binding RulesWarnText}"/>
          </StackPanel>
          <TextBlock Theme="{StaticResource type-body}" Foreground="{DynamicResource ink-2}" VerticalAlignment="Center" IsVisible="{Binding HasNoRuleOn}" Text="No rule is on."/>
        </StackPanel>
        <Button Name="BlockRunButton" Classes="cf main" HorizontalAlignment="Center" Margin="0,24,0,0" IsVisible="{Binding Verdict.HasButton}"
                Command="{Binding RunCommand}" AutomationProperties.Name="Review now">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <parts:Icon Data="{StaticResource i-review}" Width="16" Height="16" Stroke="{Binding $parent[Button].Foreground}"/>
            <TextBlock Theme="{StaticResource type-body-strong}" Text="Review now"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Panel>

    <!-- The page: one recycling list of four kinds of entry, as the list of rules is. The head holds the banner, the verdict, the panel in
         one pane, the reasons, the clean files of a push and the line above the files; then each file's line, each finding, and the tail.
         Every entry stands in the one frame of the sheet. sides 32 (24 under 1304 wide), the frame at most 1292 wide (760 in one pane) and
         in the middle, the main column taking what the panel's column (340 and 32) leaves. Padding 24 above the head and 32 under the tail. -->
    <Panel Grid.Row="2" IsVisible="{Binding !ShowsEmptyBlock}">
      <ItemsControl Name="Rows" ItemsSource="{Binding Items}" Padding="0,24,0,32">
        <ItemsControl.Template>
          <ControlTemplate>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible" AllowAutoHide="False">
              <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" Margin="{TemplateBinding Padding}"/>
            </ScrollViewer>
          </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.DataTemplates>

          <DataTemplate DataType="review:ReviewHeadViewModel" x:DataType="review:ReviewHeadViewModel">
            <Border Classes="pagerow">
              <Border Classes="pagecolumn">
                <StackPanel DataContext="{Binding Model}" x:DataType="review:ReviewViewModel" Spacing="0">

                  <!-- A problem that concerns the whole page: the settings file cannot be read. -->
                  <Border IsVisible="{Binding HasBanner}" Background="{DynamicResource warn-tint}" CornerRadius="12" Padding="16,12" Margin="0,0,0,16">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <parts:EffectMark Classes="warn" Kind="Warn" Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0"/>
                      <TextBlock Grid.Column="1" Theme="{StaticResource type-body}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding BannerText}"/>
                      <Button Grid.Column="2" Classes="cf quiet small" Command="{Binding OpenSettingsFileCommand}" AutomationProperties.Name="Open the file">
                        <TextBlock Theme="{StaticResource type-meta-strong}" Text="Open the file"/>
                      </Button>
                    </Grid>
                  </Border>

                  <!-- The verdict. -->
                  <StackPanel Name="VerdictBlock" DataContext="{Binding Verdict}" x:DataType="review:VerdictViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="44">
                      <Border IsVisible="{Binding HasBadge}" Classes="badge" Classes.refused="{Binding IsRefused}" Classes.allowed="{Binding IsAllowed}"
                              Classes.incomplete="{Binding IsIncomplete}" Classes.running="{Binding IsRunning}" Classes.folder="{Binding IsFolderFindings}" VerticalAlignment="Top" Margin="0,0,14,0">
                        <Panel>
                          <parts:Icon Data="{StaticResource i-x}" Width="24" Height="24" StrokeThickness="2.4" Stroke="{DynamicResource on-block}"
                                      IsVisible="{Binding IsRefused}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <parts:Icon Data="{StaticResource i-check}" Width="24" Height="24" StrokeThickness="2.4" Stroke="{DynamicResource page}"
                                      IsVisible="{Binding IsAllowed}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <parts:Icon Data="{StaticResource i-folder}" Width="24" Height="24" StrokeThickness="1.8" Stroke="{DynamicResource on-solid}"
                                      IsVisible="{Binding IsFolderFindings}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <parts:Icon Data="M8 4v5M8 11.9v.1" Width="24" Height="24" StrokeThickness="2.4" Stroke="{DynamicResource on-solid}"
                                      IsVisible="{Binding IsIncomplete}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <parts:TurningRing Width="24" Height="24" IsVisible="{Binding IsRunning}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <WrapPanel Orientation="Horizontal">
                          <TextBlock Name="Heading" Theme="{StaticResource type-verdict}" Margin="0,0,10,0" Text="{Binding Heading}"/>
                          <TextBlock Name="HeadingTail" Theme="{StaticResource type-verdict}" TextTrimming="PrefixCharacterEllipsis" MaxWidth="560"
                                     IsVisible="{Binding HasTail}" Text="{Binding HeadingTail}"/>
                        </WrapPanel>
                        <TextBlock Theme="{StaticResource type-lead}" Foreground="{DynamicResource ink-2}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   IsVisible="{Binding HasLead}" Text="{Binding Lead}"/>
                      </StackPanel>
                      <review:CopyButton Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                         DataContext="{Binding $parent[review:ReviewView].((review:ReviewViewModel)DataContext).CopyAll}"
                                         IsVisible="{Binding $parent[review:ReviewView].((review:ReviewViewModel)DataContext).CanCopyAll}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Counts}" IsVisible="{Binding HasCounts}" Margin="0,16,0,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="review:CountPieceViewModel" x:DataType="review:CountPieceViewModel">
                          <Panel Margin="0,0,8,8">
                            <Border Classes="piece block" IsVisible="{Binding IsBlock}">
                              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <parts:EffectMark Kind="Block" Width="17" Height="17" Shape="{DynamicResource on-block}" Sign="{DynamicResource block}"/>
                                <TextBlock Theme="{StaticResource type-count}" Foreground="{DynamicResource on-block}" VerticalAlignment="Center" Text="{Binding Text}"/>
                              </StackPanel>
                            </Border>
                            <Border Classes="piece allow" IsVisible="{Binding IsAllow}">
                              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <parts:Icon Data="{StaticResource i-check}" Width="17" Height="17" StrokeThickness="2" Stroke="{DynamicResource page}" VerticalAlignment="Center"/>
                                <TextBlock Theme="{StaticResource type-count}" Foreground="{DynamicResource page}" VerticalAlignment="Center" Text="{Binding Text}"/>
                              </StackPanel>
                            </Border>
                            <Border Classes="piece warn" IsVisible="{Binding IsWarn}">
                              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <parts:EffectMark Kind="Warn" Width="17" Height="17" Shape="{DynamicResource on-warn}" Sign="{DynamicResource warn}"/>
                                <TextBlock Theme="{StaticResource type-count}" Foreground="{DynamicResource on-warn}" VerticalAlignment="Center" Text="{Binding Text}"/>
                              </StackPanel>
                            </Border>
                            <Border Classes="piece" Background="{DynamicResource hover}" Padding="12,0,4,0" IsVisible="{Binding IsFilter}">
                              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Theme="{StaticResource type-body}" FontWeight="500" VerticalAlignment="Center" Text="Only"/>
                                <TextBlock Theme="{StaticResource code-strong}" VerticalAlignment="Center" Text="{Binding Text}"/>
                                <Button Classes="clearfilter" Command="{Binding Clear}" AutomationProperties.Name="{Binding ClearName}"/>
                              </StackPanel>
                            </Border>
                            <TextBlock IsVisible="{Binding IsPlain}" Theme="{StaticResource type-lead}" Foreground="{DynamicResource ink-2}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding Text}"/>
                          </Panel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,4,0,6"
                          DataContext="{Binding $parent[review:ReviewView].((review:ReviewViewModel)DataContext)}"
                          x:DataType="review:ReviewViewModel" IsVisible="{Binding HasAppliedFixes}">
                      <parts:Icon Data="{StaticResource i-info}" Width="16" Height="16" Stroke="{DynamicResource ink-3}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Theme="{StaticResource type-body}" Foreground="{DynamicResource ink-2}" TextWrapping="Wrap"
                                 VerticalAlignment="Center" Text="{Binding AppliedFixesText}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Facts}" IsVisible="{Binding HasFacts}" Margin="0,6,0,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="20"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="review:FactViewModel" x:DataType="review:FactViewModel">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <parts:Icon Data="{StaticResource i-branch}" Width="15" Height="15" Stroke="{DynamicResource ink-3}" IsVisible="{Binding IsCommits}"/>
                            <parts:Icon Data="{StaticResource i-file}" Width="15" Height="15" Stroke="{DynamicResource ink-3}" IsVisible="{Binding IsFiles}"/>
                            <parts:Icon Data="{StaticResource i-time}" Width="15" Height="15" Stroke="{DynamicResource ink-3}" IsVisible="{Binding IsTime}"/>
                            <TextBlock Theme="{StaticResource type-body}" Foreground="{DynamicResource ink-2}" FontFeatures="+tnum"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding Text}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border IsVisible="{Binding LeavesOutUncommitted}" Background="{DynamicResource side}" CornerRadius="10" MinHeight="36" Padding="12,8,14,8" Margin="0,14,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <parts:Icon Data="{StaticResource i-info}" Width="16" Height="16" Stroke="{DynamicResource ink-2}" VerticalAlignment="Center"/>
                        <TextBlock Theme="{StaticResource type-body}" FontWeight="500" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Uncommitted changes are not part of this review."/>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <!-- In one pane the panel is one line under the verdict. -->
                  <review:FilesPanel Margin="0,20,0,0" IsVisible="{Binding IsOnePane}" DataContext="{Binding}"/>

                  <!-- An incomplete review: the reasons, in the form of findings; the tool's own message opens. -->
                  <StackPanel IsVisible="{Binding HasReasons}" Margin="0,20,0,0">
                    <TextBlock Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}" VerticalAlignment="Center" MinHeight="36" Margin="8,0,0,0"
                               Text="{Binding ReasonsLine}"/>
                    <ItemsControl ItemsSource="{Binding ReasonsShown}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="review:ReasonViewModel" x:DataType="review:ReasonViewModel">
                          <Border BorderBrush="{DynamicResource line}" BorderThickness="0,1,0,0">
                            <StackPanel>
                              <Button Classes="findinghead" IsVisible="{Binding HasMessage}" Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding SpokenName}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                  <parts:Icon Data="{StaticResource i-off}" Width="14" Height="14" Stroke="{DynamicResource off}" VerticalAlignment="Top" Margin="0,-2,0,0"/>
                                  <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Theme="{StaticResource type-body-strong}" TextWrapping="Wrap" Text="{Binding Failed}"/>
                                    <TextBlock Theme="{StaticResource code}" Foreground="{DynamicResource ink-2}" TextWrapping="Wrap" Text="{Binding About}"/>
                                  </StackPanel>
                                  <parts:Icon Grid.Column="2" Classes="chevron" Classes.open="{Binding IsOpen}" Data="{StaticResource i-right}" Width="16" Height="16"
                                              Stroke="{DynamicResource ink-3}" VerticalAlignment="Top"/>
                                </Grid>
                              </Button>
                              <Grid IsVisible="{Binding HasNoMessage}" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="8,11,12,11" AutomationProperties.Name="{Binding SpokenName}">
                                <parts:Icon Data="{StaticResource i-off}" Width="14" Height="14" Stroke="{DynamicResource off}" VerticalAlignment="Top" Margin="0,-2,0,0"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                  <TextBlock Theme="{StaticResource type-body-strong}" TextWrapping="Wrap" Text="{Binding Failed}"/>
                                  <TextBlock Theme="{StaticResource code}" Foreground="{DynamicResource ink-2}" TextWrapping="Wrap" Text="{Binding About}"/>
                                </StackPanel>
                              </Grid>
                              <StackPanel Classes="reasonbody" IsVisible="{Binding IsOpen}">
                                <Border Background="{DynamicResource page}" BorderBrush="{DynamicResource line}" BorderThickness="1" CornerRadius="12" Padding="12,10" ClipToBounds="True">
                                  <ScrollViewer MaxHeight="200" HorizontalScrollBarVisibility="Disabled">
                                    <SelectableTextBlock Theme="{StaticResource code}" TextWrapping="Wrap" Text="{Binding Message}"/>
                                  </ScrollViewer>
                                </Border>
                                <Button Classes="cf outlined small" HorizontalAlignment="Left" Margin="0,10,0,0" IsVisible="{Binding OpensDoctor}"
                                        Command="{Binding OpenDoctorCommand}" AutomationProperties.Name="Open Doctor">
                                  <StackPanel Orientation="Horizontal" Spacing="6">
                                    <parts:Icon Data="{StaticResource i-doc}" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}"/>
                                    <TextBlock Theme="{StaticResource type-meta-strong}" Text="Open Doctor"/>
                                  </StackPanel>
                                </Button>
                              </StackPanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border BorderBrush="{DynamicResource line}" BorderThickness="0,1,0,0"/>
                    <Button Classes="cf outlined small" HorizontalAlignment="Right" Margin="0,12,0,0" IsVisible="{Binding CanShowAllReasons}"
                            Command="{Binding ShowAllReasonsCommand}" AutomationProperties.Name="{Binding ShowAllReasonsText}">
                      <TextBlock Theme="{StaticResource type-meta-strong}" Text="{Binding ShowAllReasonsText}"/>
                    </Button>
                  </StackPanel>

                  <!-- A clean push: the files it holds, each with a tick. They are not buttons. -->
                  <StackPanel IsVisible="{Binding HasCleanPush}" Margin="0,20,0,0">
                    <TextBlock Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}" VerticalAlignment="Center" MinHeight="36" Margin="8,0,0,0"
                               Text="{Binding CleanPushLine}"/>
                    <ItemsControl ItemsSource="{Binding CleanPushFiles}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="sys:String" x:DataType="sys:String">
                          <Border BorderBrush="{DynamicResource line}" BorderThickness="0,1,0,0">
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" Height="44" Margin="8,0,12,0">
                              <parts:Icon Data="{StaticResource i-check}" Width="16" Height="16" Stroke="{DynamicResource req-ink}" VerticalAlignment="Center"/>
                              <parts:Icon Grid.Column="1" Data="{StaticResource i-file}" Width="16" Height="16" Stroke="{DynamicResource ink-3}" VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="2" Theme="{StaticResource code}" TextTrimming="PrefixCharacterEllipsis" VerticalAlignment="Center" Text="{Binding}"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border BorderBrush="{DynamicResource line}" BorderThickness="0,1,0,0"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,16,0,0" IsVisible="{Binding HasCleanPushMore}">
                      <parts:Icon Data="{StaticResource i-check}" Width="15" Height="15" Stroke="{DynamicResource req-ink}"/>
                      <TextBlock Theme="{StaticResource type-body}" Foreground="{DynamicResource ink-2}" Text="{Binding CleanPushMore}"/>
                    </StackPanel>
                  </StackPanel>

                  <!-- The files with their findings: the line above them. -->
                  <StackPanel IsVisible="{Binding HasFiles}" Margin="0,20,0,0">
                    <Grid ColumnDefinitions="*,Auto" MinHeight="36" Margin="8,0,0,4">
                      <TextBlock Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}" VerticalAlignment="Center" Text="{Binding FilesLine}"/>
                      <Button Name="OpenAllButton" Grid.Column="1" Classes="cf quiet small" Command="{Binding ToggleAllCommand}" AutomationProperties.Name="{Binding OpenAllText}">
                        <TextBlock Theme="{StaticResource type-meta-strong}" Text="{Binding OpenAllText}"/>
                      </Button>
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Border>
          </DataTemplate>

          <!-- A file's line. -->
          <DataTemplate DataType="review:FileGroupViewModel" x:DataType="review:FileGroupViewModel">
            <Border Classes="pagerow">
              <Border Classes="pagecolumn">
                <Border BorderBrush="{DynamicResource line}" BorderThickness="0,1,0,0">
                  <Button Classes="fileline" Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding SpokenName}">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                      <parts:Icon Classes="chevron" Classes.open="{Binding IsOpen}" Data="{StaticResource i-right}" Width="16" Height="16" Stroke="{DynamicResource ink-3}"/>
                      <parts:Icon Grid.Column="1" Data="{StaticResource i-file}" Width="16" Height="16" Stroke="{DynamicResource ink-3}"/>
                      <TextBlock Grid.Column="2" Theme="{StaticResource code-strong}" TextTrimming="PrefixCharacterEllipsis"
                                 VerticalAlignment="Center" ToolTip.Tip="{Binding Path}" Text="{Binding Path}"/>
                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                          <StackPanel Orientation="Horizontal" Spacing="5" MinWidth="34">
                            <parts:EffectMark Classes="block" Kind="Block" Width="14" Height="14" IsVisible="{Binding HasBlock}"/>
                            <TextBlock Theme="{StaticResource type-meta-strong}" FontFeatures="+tnum" IsVisible="{Binding HasBlock}" Text="{Binding BlockText}"/>
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="5" MinWidth="34">
                            <parts:EffectMark Classes="warn" Kind="Warn" Width="14" Height="14" IsVisible="{Binding HasWarn}"/>
                            <TextBlock Theme="{StaticResource type-meta-strong}" FontFeatures="+tnum" IsVisible="{Binding HasWarn}" Text="{Binding WarnText}"/>
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding HasFixedFindings}">
                          <parts:Icon Data="{StaticResource i-check}" Width="14" Height="14" Stroke="{DynamicResource ink-3}" VerticalAlignment="Center"/>
                          <TextBlock Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}" VerticalAlignment="Center" Text="{Binding FixedText}"/>
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Button>
                </Border>
              </Border>
            </Border>
          </DataTemplate>

          <!-- A finding, under its file's line. -->
          <DataTemplate DataType="review:FindingViewModel" x:DataType="review:FindingViewModel">
            <Border Classes="pagerow">
              <Border Classes="pagecolumn">
                <Border Margin="26,0,0,0" BorderBrush="{DynamicResource line}" BorderThickness="0,1,0,0">
                  <StackPanel>
                    <Button Classes="findinghead" Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding SpokenName}">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="0,-2,0,0" Height="24" Width="{Binding EffectWidth}">
                          <parts:EffectMark Classes="block" Kind="Block" Width="14" Height="14" IsVisible="{Binding ShowsBlock}" VerticalAlignment="Center"/>
                          <parts:EffectMark Classes="warn" Kind="Warn" Width="14" Height="14" IsVisible="{Binding ShowsWarn}" VerticalAlignment="Center"/>
                          <parts:Icon Data="{StaticResource i-check}" Stroke="{DynamicResource req-ink}" Width="14" Height="14" IsVisible="{Binding IsFixed}" VerticalAlignment="Center"/>
                          <TextBlock Theme="{StaticResource type-effect}" Classes.fixedfinding="{Binding IsFixed}" VerticalAlignment="Center" Text="{Binding EffectWord}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Theme="{StaticResource type-body-strong}" Classes="message" Classes.fixedfinding="{Binding IsFixed}" TextWrapping="Wrap" Text="{Binding Message}"/>
                          <WrapPanel Orientation="Horizontal">
                            <TextBlock Theme="{StaticResource code}" Foreground="{DynamicResource ink-2}" Margin="0,0,8,0" Text="{Binding RuleId}"/>
                            <TextBlock Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}" TextWrapping="Wrap"
                                       IsVisible="{Binding HasTitle}" Text="{Binding Title}"/>
                          </WrapPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Theme="{StaticResource code}" Foreground="{DynamicResource ink-2}" VerticalAlignment="Top"
                                   IsVisible="{Binding HasLine}" Text="{Binding LineText}"/>
                        <parts:Icon Grid.Column="3" Classes="chevron" Classes.open="{Binding IsOpen}" Data="{StaticResource i-right}" Width="16" Height="16"
                                    Stroke="{DynamicResource ink-3}" VerticalAlignment="Top"/>
                      </Grid>
                    </Button>
                    <StackPanel Classes="findingbody" Classes.folder="{Binding IsFolderReview}" IsVisible="{Binding IsOpen}">
                      <TextBlock Theme="{StaticResource type-body}" Foreground="{DynamicResource ink-2}" TextWrapping="Wrap" AutomationProperties.Name="{Binding SourceLine}">
                        <Run Text="{Binding SourcePrefix}"/><Run Classes="scope" Classes.pattern="{Binding IsScoped}" Text="{Binding SourceScope}"/><Run Text="{Binding SourceSuffix}"/>
                      </TextBlock>
                      <review:SentencePieces Pieces="{Binding Sentence}" IsVisible="{Binding HasSentence}" Margin="0,8,0,0"/>
                      <TextBlock IsVisible="{Binding HasDiff}" Theme="{StaticResource type-body}" Foreground="{DynamicResource ink-2}"
                                 TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding ReachText}"/>
                      <TextBlock IsVisible="{Binding HasByteChanges}" Theme="{StaticResource type-body}" Foreground="{DynamicResource ink-2}"
                                 TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding ByteChangesText}"/>
                      <review:FixDifference IsVisible="{Binding HasDiff}" Margin="0,12,0,0"/>
                      <Border IsVisible="{Binding HasCode}" Margin="0,12,0,0" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource line}"
                              Padding="0,8" ClipToBounds="True" Background="{DynamicResource page}">
                        <StackPanel>
                          <TextBlock IsVisible="{Binding IsExcerptStale}" Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}"
                                     TextWrapping="Wrap" Margin="12,0,12,8" Text="As reviewed. The file has changed since."/>
                          <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="review:CodeLineViewModel" x:DataType="review:CodeLineViewModel">
                                <Panel Height="20">
                                  <Border Background="{DynamicResource diff-del}" IsVisible="{Binding IsBlocking}"/>
                                  <Border Background="{DynamicResource block}" Width="3" HorizontalAlignment="Left" IsVisible="{Binding IsBlocking}"/>
                                  <Border Background="{DynamicResource warn-tint}" IsVisible="{Binding IsWarning}"/>
                                  <Border Background="{DynamicResource warn}" Width="3" HorizontalAlignment="Left" IsVisible="{Binding IsWarning}"/>
                                  <Grid ColumnDefinitions="44,14,*">
                                    <TextBlock Theme="{StaticResource code}" Foreground="{DynamicResource ink-3}" TextAlignment="Right" Text="{Binding Number}"/>
                                    <TextBlock Grid.Column="2" Theme="{StaticResource code}" TextWrapping="NoWrap" review:CodeText.Segments="{Binding Segments}"/>
                                  </Grid>
                                </Panel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                      <Border IsVisible="{Binding HasFixNotice}" Background="{DynamicResource warn-tint}" CornerRadius="12"
                              Padding="16,12" Margin="0,16,0,0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                          <parts:EffectMark Classes="warn" Kind="Warn" Width="16" Height="16" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Theme="{StaticResource type-body}" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding FixNoticeText}"/>
                          <Button Grid.Column="2" Classes="cf outlined small" VerticalAlignment="Center" Content="Review again"
                                  Command="{Binding $parent[review:ReviewView].((review:ReviewViewModel)DataContext).RunCommand}"/>
                        </Grid>
                      </Border>
                      <TextBlock IsVisible="{Binding HasPreparationProblem}" Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}"
                                 TextWrapping="Wrap" Margin="0,16,0,-8" Text="{Binding PreparationProblem}"/>
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <TextBlock IsVisible="{Binding ShowsNoFix}" VerticalAlignment="Center" Theme="{StaticResource type-meta}"
                                     Foreground="{DynamicResource ink-2}" Text="No automatic fix."/>
                          <Button Classes="cf main" IsVisible="{Binding ShowsFixButton}" IsEnabled="{Binding !IsPreparing}"
                                  Command="{Binding ApplyFixCommand}" AutomationProperties.Name="{Binding FixButtonText}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <parts:Icon Data="{StaticResource i-check}" Width="16" Height="16" Stroke="{Binding $parent[Button].Foreground}"
                                          IsVisible="{Binding !IsPreparing}"/>
                              <parts:TurningRing Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding IsPreparing}"/>
                              <TextBlock Theme="{StaticResource type-body-strong}" Text="{Binding FixButtonText}"/>
                            </StackPanel>
                          </Button>
                          <review:CopyButton DataContext="{Binding Copy}"/>
                        </StackPanel>
                        <StackPanel Classes="findingopens" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding HasOpenActions}">
                          <Button Classes="cf outlined" Command="{Binding OpenLineCommand}" IsVisible="{Binding HasSetting}"
                                  AutomationProperties.Name="{Binding OpenLineText}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <parts:Icon Data="{StaticResource i-open}" Width="16" Height="16" Stroke="{Binding $parent[Button].Foreground}"/>
                              <TextBlock Theme="{StaticResource type-body-strong}" Text="{Binding OpenLineText}"/>
                            </StackPanel>
                          </Button>
                          <Button Classes="cf outlined" IsVisible="{Binding CanOpenRule}"
                                  Command="{Binding OpenRuleCommand}" AutomationProperties.Name="Open the rule">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <parts:Icon Data="{StaticResource i-rules}" Width="16" Height="16" Stroke="{Binding $parent[Button].Foreground}"/>
                              <TextBlock Theme="{StaticResource type-body-strong}" Text="Open the rule"/>
                            </StackPanel>
                          </Button>
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Border>
            </Border>
          </DataTemplate>

          <!-- The tail: the line that closes the files, then a folder review's files without findings. -->
          <DataTemplate DataType="review:ReviewTailViewModel" x:DataType="review:ReviewTailViewModel">
            <Border Classes="pagerow">
              <Border Classes="pagecolumn">
                <StackPanel DataContext="{Binding Model}" x:DataType="review:ReviewViewModel">
                  <Border IsVisible="{Binding HasFiles}" BorderBrush="{DynamicResource line}" BorderThickness="0,1,0,0"/>

                  <!-- A folder review: the files without findings, after the list. -->
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,16,0,0" IsVisible="{Binding HasFolderClean}">
                    <parts:Icon Data="{StaticResource i-check}" Width="15" Height="15" Stroke="{DynamicResource req-ink}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <TextBlock Theme="{StaticResource type-body}" Foreground="{DynamicResource ink-2}" TextWrapping="Wrap" Text="{Binding FolderCleanLead}"/>
                    <TextBlock Theme="{StaticResource code}" Foreground="{DynamicResource ink-2}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding FolderCleanNames}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Border>
          </DataTemplate>

        </ItemsControl.DataTemplates>
      </ItemsControl>

      <!-- The panel stands over the page, in the frame's second column, and keeps its place 24 under the review bar while the page scrolls;
           the view moves it up when the page ends. In one pane it is in the head instead. -->
      <Border Classes="pagerow" VerticalAlignment="Top" Margin="0,24,12,0" IsVisible="{Binding !IsOnePane}">
        <Border Classes="pageframe">
          <review:FilesPanel Name="SidePanel" HorizontalAlignment="Right" Width="340" DataContext="{Binding}"/>
        </Border>
      </Border>
    </Panel>

  </Grid>

</UserControl>
