<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CF.App.Rules.Page"
             xmlns:parts="using:CF.App.Parts"
             x:Class="CF.App.Rules.Page.PathPanel"
             x:ClassModifier="internal"
             x:DataType="local:PathPieceViewModel">

  <!-- The panel of a path token: 400 wide. The field, what the pattern names in the repository as it is typed (a polite live
       region), a hairline and the note on the wildcards. A pattern that is not valid has its reason in place of the count. When the
       window has no room for all of it, the field stays and what is under it scrolls. -->
  <Border Name="Surface" Classes="picker" Width="400" AutomationProperties.Name="Path">
    <Grid RowDefinitions="Auto,*">

      <Border Classes="valuefield" Classes.refused="{Binding HasProblem}" Height="36" Margin="2,4" CornerRadius="8"
              BorderThickness="2" Padding="8,0">
        <TextBox Name="Field" Classes="bare" Text="{Binding FieldText, Mode=TwoWay}"
                 AutomationProperties.Name="{Binding FieldSpokenName}" FontSize="13"
                 FontFamily="{StaticResource code-font}" Foreground="{DynamicResource ink}"/>
      </Border>

      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel>

      <StackPanel IsVisible="{Binding ShowsMatches}" AutomationProperties.LiveSetting="Polite">
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="10,8,10,2">
          <parts:Icon Data="{StaticResource i-file}" Width="14" Height="14" Stroke="{DynamicResource ink-3}" VerticalAlignment="Center"/>
          <TextBlock Theme="{StaticResource type-body}" Foreground="{DynamicResource ink-2}" VerticalAlignment="Center">
            <Run Text="{Binding MatchesBefore}"/><Run FontWeight="SemiBold" Foreground="{DynamicResource ink}" Text="{Binding MatchesCount}"/><Run Text="{Binding MatchesAfter}"/>
          </TextBlock>
        </StackPanel>
        <ItemsControl IsVisible="{Binding HasFiles}" ItemsSource="{Binding FilesShown}" Margin="10,2,10,6">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="local:PathFileLine" x:DataType="local:PathFileLine">
              <TextBlock Theme="{StaticResource code}" TextWrapping="Wrap">
                <Run Foreground="{DynamicResource ink-2}" Text="{Binding Folders}"/><Run FontWeight="SemiBold" Foreground="{DynamicResource ink}" Text="{Binding Name}"/>
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock IsVisible="{Binding HasMore}" Theme="{StaticResource type-body}" Foreground="{DynamicResource ink-2}"
                   Margin="10,0,10,6" Text="{Binding MoreText}"/>
      </StackPanel>

      <StackPanel IsVisible="{Binding HasProblem}" Orientation="Horizontal" Spacing="8" Margin="10,6,10,4"
                  AutomationProperties.LiveSetting="Polite">
        <parts:EffectMark Kind="Block" Width="14" Height="14" Shape="{DynamicResource block}" Sign="{DynamicResource on-block}"
                          VerticalAlignment="Top" Margin="0,3,0,0"/>
        <TextBlock Theme="{StaticResource type-body}" Foreground="{DynamicResource block-ink}" TextWrapping="Wrap" MaxWidth="350"
                   Text="{Binding Problem}"/>
      </StackPanel>

      <Separator Classes="menu-divider"/>

      <TextBlock Margin="10,6,10,4" TextWrapping="Wrap" Theme="{StaticResource type-body}" Foreground="{DynamicResource ink-2}">
        <Run Text="From the root of "/><Run Text="{Binding RepositoryName}"/><Run Text=". "/>
        <Run FontFamily="{StaticResource code-font}" Foreground="{DynamicResource ink}" Text="*"/><Run Text=" stands for any characters in a name, "/><Run FontFamily="{StaticResource code-font}" Foreground="{DynamicResource ink}" Text="**"/><Run Text=" for any folders, "/><Run FontFamily="{StaticResource code-font}" Foreground="{DynamicResource ink}" Text="?"/><Run Text=" for one character."/>
      </TextBlock>

      </StackPanel>
      </ScrollViewer>

    </Grid>
  </Border>

</UserControl>
