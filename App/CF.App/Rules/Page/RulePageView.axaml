<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rules="using:CF.App.Rules"
             xmlns:local="using:CF.App.Rules.Page"
             xmlns:parts="using:CF.App.Parts"
             xmlns:settings="using:CF.App.Settings"
             x:Class="CF.App.Rules.Page.RulePageView"
             x:ClassModifier="internal"
             x:DataType="local:RulePageViewModel">

  <!-- The page of a team rule: the first row, the title, the sentence and "When code
       breaks it". Try it is the last part. The sheet scrolls; its content is never wider than
       900. In one pane the page has a back button, and its sides are 24. -->
  <UserControl.Styles>
    <Style Selector="Popup">
      <Setter Property="local:PickerRoom.Fits" Value="True"/>
    </Style>
    <Style Selector="local|RulePageView Border.sheet">
      <Setter Property="Padding" Value="32,0,32,32"/>
    </Style>
    <Style Selector="local|RulePageView Border.rulehead">
      <Setter Property="Padding" Value="32,0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="local|RulePageView.onepane Border.rulehead">
      <Setter Property="Padding" Value="24,0"/>
    </Style>
    <Style Selector="local|RulePageView Border.rulehead.stuck">
      <Setter Property="BorderBrush" Value="{DynamicResource line}"/>
    </Style>
    <Style Selector="local|RulePageView Border.rulehead.tighter TextBlock.tagword">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="local|RulePageView Border.rulehead.tight TextBlock.switchword:not(.draftword)">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="local|RulePageView StackPanel.stategroup">
      <Setter Property="IsVisible" Value="False"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="AutomationProperties.AccessibilityView" Value="Raw"/>
    </Style>
    <Style Selector="local|RulePageView StackPanel.stategroup.on">
      <Setter Property="IsVisible" Value="True"/>
      <Setter Property="AutomationProperties.AccessibilityView" Value="Content"/>
    </Style>
    <Style Selector="TextBlock.id-help">
      <Setter Property="Foreground" Value="{DynamicResource ink-2}"/>
    </Style>
    <Style Selector="TextBlock.id-help.refused">
      <Setter Property="Foreground" Value="{DynamicResource block-ink}"/>
    </Style>
    <Style Selector="Border.id-outline">
      <Setter Property="BorderBrush" Value="{DynamicResource line-strong}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,0,11,0"/>
    </Style>
    <Style Selector="Border.id-outline:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource focus}"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Padding" Value="9,0,10,0"/>
    </Style>
    <Style Selector="Border.id-outline.refused">
      <Setter Property="BorderBrush" Value="{DynamicResource block}"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Padding" Value="9,0,10,0"/>
    </Style>
    <Style Selector="TextBox.rule-id /template/ TextBlock#PART_Placeholder">
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter, Segoe UI, Helvetica Neue, sans-serif"/>
      <Setter Property="Foreground" Value="{DynamicResource ink-3}"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style Selector="Button.rule-more.open">
      <Setter Property="Background" Value="{DynamicResource hover}"/>
    </Style>
    <Style Selector="Button.rule-menu-entry:pointerover /template/ Border#Surface, Button.rule-menu-entry:focus-visible /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource hover}"/>
    </Style>
    <Style Selector="local|RulePageView Button.rename">
      <Setter Property="Foreground" Value="{DynamicResource ink-2}"/>
    </Style>
    <Style Selector="local|RulePageView Button.rename:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource ink}"/>
    </Style>
    <Style Selector="local|RulePageView Button.reasonlink">
      <Setter Property="Height" Value="20"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style Selector="local|RulePageView Button.reasonlink:pointerover TextBlock.headline">
      <Setter Property="TextDecorations" Value="Underline"/>
    </Style>
    <Style Selector="local|RulePageView TextBlock.headline.bad">
      <Setter Property="Foreground" Value="{DynamicResource block-ink}"/>
    </Style>
    <Style Selector="local|RulePageView StackPanel.content">
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style Selector="local|RulePageView.onepane Border.sheet">
      <Setter Property="Padding" Value="24,0,24,32"/>
    </Style>
    <Style Selector="local|RulePageView.onepane StackPanel.content">
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="local|RulePageView Button.back">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="local|RulePageView.onepane Button.back">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

  <!-- The head stays above the scrolling sheet. The action row holds the ID and switch at the left and the state and actions
       at the right. The draft ID help has room below it. -->
  <Border Name="Head" Classes="rulehead" Background="{DynamicResource page}" BorderThickness="0,0,0,1" ZIndex="3">
    <Grid Name="HeadRow" RowDefinitions="47,Auto" ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Left">
      <StackPanel Name="LeftGroup" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Button Classes="cf quiet back" Padding="8,0,12,0" Command="{Binding $parent[rules:RulesView].((rules:RulesViewModel)DataContext).BackCommand}"
                AutomationProperties.Name="Back to the rules">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <parts:Icon Data="{StaticResource i-left}" Width="16" Height="16" Stroke="{Binding $parent[Button].Foreground}"/>
            <TextBlock Classes="tagword" Theme="{StaticResource type-body-strong}" FontWeight="Medium" Text="Rules"/>
          </StackPanel>
        </Button>
        <TextBlock IsVisible="{Binding IsDraft}" Theme="{StaticResource type-label}" FontWeight="SemiBold"
                   VerticalAlignment="Center" Text="New rule"/>
        <Border IsVisible="{Binding IsSaved}" Height="24" CornerRadius="7" Padding="7,0,9,0" Background="{DynamicResource hover}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <parts:Icon Data="{StaticResource i-pen}" Width="12" Height="12" Stroke="{DynamicResource ink-2}"/>
            <TextBlock Classes="tagword" Theme="{StaticResource type-label}" Foreground="{DynamicResource ink-2}" Text="Custom rule"/>
          </StackPanel>
        </Border>
        <TextBlock Name="IdText" IsVisible="{Binding IsSaved}" Theme="{StaticResource code-strong}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding Id}"/>
        <Panel Name="IdField" Classes="id-field" IsVisible="{Binding IsDraft}" Width="220" Height="36">
          <Border Classes="id-outline" Classes.refused="{Binding HasIdProblem}" CornerRadius="10" Background="{DynamicResource page}">
            <TextBox Name="IdBox" Classes="bare rule-id" Height="32" VerticalAlignment="Center" Cursor="IBeam"
                     FontFamily="{StaticResource code-font}" FontSize="13" FontWeight="SemiBold"
                     Text="{Binding Id, Mode=TwoWay}" PlaceholderText="Letters, digits, - and _" AutomationProperties.Name="Rule ID"
                     AutomationProperties.HelpText="{Binding IdLine}" AutomationProperties.ItemStatus="{Binding IdStatus}">
              <TextBox.InnerLeftContent>
                <TextBlock Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}" Text="ID"
                           Margin="0,0,8,0" VerticalAlignment="Center" PointerPressed="OnIdLabelPressed"
                           AutomationProperties.AccessibilityView="Raw"/>
              </TextBox.InnerLeftContent>
              <TextBox.InnerRightContent>
                <parts:EffectMark IsVisible="{Binding HasIdProblem}" Kind="Block" Width="14" Height="14" Margin="8,0,0,0"
                                  Shape="{DynamicResource block}" Sign="{DynamicResource on-block}" VerticalAlignment="Center"/>
              </TextBox.InnerRightContent>
            </TextBox>
          </Border>
          <parts:FocusRing Name="IdRefusedRing" IsVisible="False" ControlRadius="10"
                           GapBrush="{DynamicResource focus-gap}" LineBrush="{DynamicResource focus}"/>
        </Panel>
        <Border Width="1" Height="24" Margin="6,0,0,0" Background="{DynamicResource line}"/>
        <StackPanel Name="SwitchGroup" Orientation="Horizontal" Spacing="12" Margin="6,0,0,0" VerticalAlignment="Center">
          <TextBlock Classes="switchword" Classes.draftword="{Binding IsDraft}" Theme="{StaticResource type-body}" FontWeight="Medium" Foreground="{DynamicResource ink-2}"
                     VerticalAlignment="Center" Text="{Binding SwitchWord}"/>
          <ToggleButton Classes="cfswitch" Classes.draft="{Binding IsDraft}" Focusable="True" IsEnabled="{Binding IsSaved}" IsChecked="{Binding IsOn, Mode=OneWay}"
                        Command="{Binding ToggleSwitchCommand}" AutomationProperties.Name="{Binding SwitchSpokenName}"/>
        </StackPanel>
      </StackPanel>

      <StackPanel Name="RightGroup" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

        <!-- Only the current state takes room, with the action buttons anchored at the right. -->
        <Panel Margin="0,0,2,0" IsVisible="{Binding IsSaved}" VerticalAlignment="Center" AutomationProperties.Name="{Binding SaveStateSpoken}"
               AutomationProperties.LiveSetting="Polite">
          <StackPanel Classes="stategroup" Classes.on="{Binding IsSavedState}" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
            <parts:Icon Data="{StaticResource i-check}" Width="14" Height="14" Stroke="{DynamicResource req-ink}" VerticalAlignment="Center"/>
            <TextBlock Classes="save-state" Theme="{StaticResource type-body}" Foreground="{DynamicResource ink-2}"
                       VerticalAlignment="Center" Text="Saved"/>
          </StackPanel>
          <StackPanel Classes="stategroup" Classes.on="{Binding IsUnsaved}" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
            <Ellipse Width="7" Height="7" Fill="{DynamicResource ink}" VerticalAlignment="Center"/>
            <TextBlock Classes="save-state" Theme="{StaticResource type-body}" Foreground="{DynamicResource ink}"
                       FontWeight="Medium" VerticalAlignment="Center" Text="Unsaved"/>
          </StackPanel>
        </Panel>

        <Button Classes="cf second" Width="84" IsVisible="{Binding IsUnsaved}" Command="{Binding DiscardCommand}"
                AutomationProperties.Name="Discard">
          <TextBlock Theme="{StaticResource type-body-strong}" HorizontalAlignment="Center" Text="Discard"/>
        </Button>
        <Button Classes="cf main" Classes.unavailable="{Binding !CanSave}"
                Width="104" IsVisible="{Binding IsUnsaved}" Command="{Binding AttemptSaveCommand}"
                AutomationProperties.Name="Save rule" AutomationProperties.HelpText="{Binding SaveButtonHelp}">
          <TextBlock Theme="{StaticResource type-body-strong}" HorizontalAlignment="Center" Text="Save rule"/>
        </Button>

        <Panel>
          <Button Name="MoreButton" Classes="cf quiet rule-more" Classes.open="{Binding IsMoreOpen}" Width="36" Padding="0" IsEnabled="{Binding IsSaved}" Command="{Binding OpenMoreCommand}"
                  AutomationProperties.Name="{Binding MoreSpokenName}">
            <parts:Icon Data="{StaticResource i-more}" Width="16" Height="16" StrokeThickness="2.4"
                        Stroke="{Binding $parent[Button].Foreground}"/>
          </Button>
          <Popup Name="MorePopup" local:PickerRoom.Fits="False" Opened="OnMoreOpened" IsOpen="{Binding IsMoreOpen, Mode=TwoWay}" PlacementTarget="{Binding #MoreButton}"
                 Placement="BottomEdgeAlignedRight" VerticalOffset="6" IsLightDismissEnabled="True"
                 ShouldUseOverlayLayer="True" PlacementConstraintAdjustment="SlideX, FlipY">
            <Border Classes="picker" Width="264">
              <StackPanel Name="RuleMenu" Focusable="True" IsTabStop="False" KeyDown="OnRuleMenuKey">
              <Button Name="DuplicateEntry" Focusable="True" Classes="pick rule-menu-entry" Height="52" Padding="10,8"
                      Command="{Binding DuplicateRuleCommand}" AutomationProperties.Name="Duplicate rule. A copy, with an ID you choose.">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <parts:Icon Data="{StaticResource i-copy}" Width="14" Height="14" Stroke="{DynamicResource ink-2}"
                              VerticalAlignment="Top" Margin="0,3,0,0"/>
                  <StackPanel>
                    <TextBlock Theme="{StaticResource type-body}" Text="Duplicate rule"/>
                    <TextBlock Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}" Text="A copy, with an ID you choose."/>
                  </StackPanel>
                </StackPanel>
              </Button>
              <Separator Classes="menu-divider"/>
              <Button Name="RemoveEntry" Focusable="True" Classes="pick rule-menu-entry" Height="36" Command="{Binding RemoveRuleCommand}" AutomationProperties.Name="Remove rule">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <parts:Icon Data="{StaticResource i-bin}" Width="14" Height="14" Stroke="{DynamicResource block-ink}"/>
                  <TextBlock Theme="{StaticResource type-body}" Foreground="{DynamicResource block-ink}" Text="Remove rule"/>
                </StackPanel>
              </Button>
              </StackPanel>
            </Border>
          </Popup>
        </Panel>
      </StackPanel>
      <Grid Name="DraftIdLine" ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Left" Grid.Row="1" Grid.ColumnSpan="3"
            IsVisible="{Binding IsDraft}" Height="24">
        <parts:EffectMark IsVisible="{Binding HasIdProblem}" Kind="Block" Width="13" Height="13"
                          Margin="0,0,6,0" VerticalAlignment="Center" Shape="{DynamicResource block}" Sign="{DynamicResource on-block}"/>
        <Button Name="IdFix" Classes="linelink" Grid.Column="2" HorizontalAlignment="Left"
                IsVisible="{Binding HasIdProblem}" Command="{Binding UseSuggestedIdCommand}"
                AutomationProperties.HelpText="{Binding IdFixDescription}" ToolTip.Tip="{Binding IdFixDescription}">
          <TextBlock Classes="line-text" Theme="{StaticResource type-meta-strong}" Text="{Binding IdFixLabel}" Foreground="{DynamicResource ink}"/>
        </Button>
        <TextBlock Name="IdHelp" Grid.Column="1" Classes="id-help" Classes.refused="{Binding HasIdProblem}"
                   Theme="{StaticResource type-meta}" Text="{Binding IdLine}" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
      </Grid>
      <TextBlock Name="IdAnnouncement" Grid.Row="1" Width="1" Height="1" Opacity="0" IsHitTestVisible="False"
                 IsVisible="{Binding IsDraft}" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
  </Border>

  <ScrollViewer Name="Scroller" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
    <Border Name="Sheet" Classes="sheet">
      <StackPanel Classes="content" Name="SheetContent">

        <!-- A refused change: the reason, at the top of the sheet, 16 above the first row. It goes with the next edit. -->
        <Border IsVisible="{Binding HasError}" Margin="0,0,0,16" Padding="16,12" CornerRadius="12"
                Background="{DynamicResource warn-tint}" AutomationProperties.Name="{Binding ErrorText}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <parts:EffectMark Kind="Warn" Width="16" Height="16" Shape="{DynamicResource warn}" Sign="{DynamicResource on-warn}"
                              VerticalAlignment="Top" Margin="0,2,0,0"/>
            <TextBlock Name="ErrorLine" Grid.Column="1" Theme="{StaticResource type-body}" TextWrapping="Wrap" Text="{Binding ErrorText}"/>
          </Grid>
        </Border>

        <!-- The title: a text box that looks like a heading, as wide as its text, and Rename beside it. -->
        <StackPanel Orientation="Horizontal" Margin="-8,8,0,0">
          <Border Classes="titlebox">
            <TextBox Name="TitleBox" Classes="bare" Text="{Binding Title, Mode=TwoWay}" PlaceholderText="Name the rule"
                     Height="NaN" MinHeight="0" FontSize="28" FontWeight="Bold" LetterSpacing="-0.7" TextWrapping="Wrap"
                     AutomationProperties.Name="Title of the rule"/>
          </Border>
          <Button Classes="cf quiet small rename" Margin="6,8,0,0" VerticalAlignment="Center" Command="{Binding RenameCommand}"
                  ToolTip.Tip="Rename the rule (F2)" AutomationProperties.Name="Rename the rule">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <parts:Icon Data="{StaticResource i-pen}" Width="13" Height="13" Stroke="{Binding $parent[Button].Foreground}"/>
              <TextBlock Theme="{StaticResource type-meta}" FontWeight="Medium" Text="Rename"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- The line under the title: 20 high, one line, never empty; 2 below the title and 14 above the sentence. It says when the rule
             was saved, what changed, or why it cannot be saved. -->
        <Grid Name="HeadLine" ColumnDefinitions="Auto,*" ColumnSpacing="8" Height="20" Margin="0,2,0,14" ClipToBounds="True">
          <Panel VerticalAlignment="Center">
            <parts:Icon IsVisible="{Binding HeadLineShowsFile}" Data="{StaticResource i-file}" Width="14" Height="14" Stroke="{DynamicResource ink-3}"/>
            <parts:Icon IsVisible="{Binding HeadLineShowsPen}" Data="{StaticResource i-pen}" Width="14" Height="14" Stroke="{DynamicResource ink-3}"/>
            <parts:EffectMark IsVisible="{Binding HeadLineIsBad}" Kind="Block" Width="14" Height="14" Shape="{DynamicResource block}"
                              Sign="{DynamicResource on-block}"/>
          </Panel>
          <TextBlock Classes="headline" Classes.bad="{Binding HeadLineIsBad}" Theme="{StaticResource type-body}" Foreground="{DynamicResource ink-2}"
                     Grid.Column="1" IsVisible="{Binding !HeadLineIsBad}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding HeadLine}"/>
          <!-- Why it cannot be saved is a link: the keyboard reaches it here and it goes to the field the reason is about. -->
          <Button Name="BlockerLink" Grid.Column="1" Classes="cf quiet reasonlink" IsVisible="{Binding HeadLineIsBad}" Command="{Binding GoToBlockerCommand}"
                  ToolTip.Tip="{Binding SaveBlocker}" AutomationProperties.Name="{Binding SaveBlocker}">
            <TextBlock Classes="headline bad" Theme="{StaticResource type-body}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" Text="{Binding HeadLine}"/>
          </Button>
        </Grid>

        <!-- Sent here from another screen to be narrowed: where from, and the way back. It goes when the rule is saved or discarded. -->
        <Border IsVisible="{Binding HasOrigin}" Margin="0,4,0,16" Background="{DynamicResource side}" CornerRadius="12" Padding="14,8,8,8">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <parts:Icon Data="{StaticResource i-exempt}" Width="15" Height="15" Stroke="{DynamicResource ink-3}" VerticalAlignment="Center"/>
            <settings:MarkedText Grid.Column="1" Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}" VerticalAlignment="Center"
                                 Marked="{Binding OriginText}"/>
            <Button Grid.Column="2" Classes="cf quiet small" VerticalAlignment="Center" Command="{Binding BackToOriginCommand}"
                    AutomationProperties.Name="Back to Exemptions">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <parts:Icon Data="{StaticResource i-left}" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}"/>
                <TextBlock Theme="{StaticResource type-meta-strong}" Text="Back to Exemptions"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- The sentence: a panel of well; one grid for every clause, a label column of 90, 12, then the flow. -->
        <Border Classes="sentence" Background="{DynamicResource well}" CornerRadius="16" Padding="24,16">
          <StackPanel Spacing="8">

            <Grid Classes="clause" ColumnDefinitions="90,12,*">
              <TextBlock Theme="{StaticResource type-sentence}" Foreground="{DynamicResource ink-2}"
                         HorizontalAlignment="Right" Text="For"/>
              <WrapPanel Grid.Column="2" ItemSpacing="8" LineSpacing="8">
                <Panel>
                  <Button Name="ArtifactButton" Classes="token for" Classes.empty="{Binding ArtifactIsEmpty}"
                          Classes.open="{Binding ArtifactPicker.IsOpen}" Command="{Binding OpenArtifactCommand}"
                          ToolTip.Tip="What the rule is about" AutomationProperties.Name="{Binding ArtifactSpokenName}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Classes="word" Theme="{StaticResource type-token}" Text="{Binding ArtifactTokenText}"/>
                      <parts:Icon Data="{StaticResource i-down}" Width="13" Height="13" StrokeThickness="1.8"
                                  Stroke="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Popup IsOpen="{Binding ArtifactPicker.IsOpen, Mode=TwoWay}" PlacementTarget="{Binding #ArtifactButton}"
                         Placement="BottomEdgeAlignedLeft" VerticalOffset="6" IsLightDismissEnabled="True"
                         ShouldUseOverlayLayer="True" PlacementConstraintAdjustment="SlideX">
                    <local:PickerPanel DataContext="{Binding ArtifactPicker}"/>
                  </Popup>
                </Panel>
                <TextBlock Theme="{StaticResource type-sentence}" Foreground="{DynamicResource ink-2}" Text="in"/>
                <Panel>
                  <Button Name="LanguageButton" Classes="token for" Classes.open="{Binding LanguagePicker.IsOpen}"
                          Command="{Binding OpenLanguageCommand}" ToolTip.Tip="Language"
                          AutomationProperties.Name="{Binding LanguageSpokenName}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Classes="word" Theme="{StaticResource type-token}" Text="{Binding LanguageText}"/>
                      <parts:Icon Data="{StaticResource i-down}" Width="13" Height="13" StrokeThickness="1.8"
                                  Stroke="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Popup IsOpen="{Binding LanguagePicker.IsOpen, Mode=TwoWay}" PlacementTarget="{Binding #LanguageButton}"
                         Placement="BottomEdgeAlignedLeft" VerticalOffset="6" IsLightDismissEnabled="True"
                         ShouldUseOverlayLayer="True" PlacementConstraintAdjustment="SlideX">
                    <local:PickerPanel DataContext="{Binding LanguagePicker}"/>
                  </Popup>
                </Panel>
              </WrapPanel>
            </Grid>

            <!-- Where the rule applies: the label "within", then a path token for each pattern, "or" between them, then the add button;
                 "every file" and the add button while there is none. -->
            <Grid Classes="clause" ColumnDefinitions="90,12,*">
              <TextBlock Theme="{StaticResource type-sentence}" Foreground="{DynamicResource ink-2}"
                         HorizontalAlignment="Right" Text="within"/>
              <StackPanel Grid.Column="2" Spacing="8">
              <ItemsControl ItemsSource="{Binding WithinFlow}" ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <local:TokenFlow ItemSpacing="8" LineSpacing="8"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>

                  <DataTemplate DataType="local:PathPieceViewModel" x:DataType="local:PathPieceViewModel">
                    <local:PathPiece/>
                  </DataTemplate>

                  <DataTemplate DataType="local:EveryFileItem" x:DataType="local:EveryFileItem">
                    <TextBlock Theme="{StaticResource type-sentence}" Foreground="{DynamicResource ink-2}" Text="every file"/>
                  </DataTemplate>

                  <DataTemplate DataType="local:AddPathItem" x:DataType="local:AddPathItem">
                    <Button Classes="cf second" VerticalAlignment="Bottom" Padding="10,0,13,0" Command="{Binding AddCommand}" ToolTip.Tip="Add a path"
                            AutomationProperties.Name="{Binding SpokenName}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <parts:Icon Data="{StaticResource i-plus}" Width="13" Height="13" StrokeThickness="1.8"
                                    Stroke="{Binding $parent[Button].Foreground}"/>
                        <TextBlock Theme="{StaticResource type-card}" Text="{Binding Text}"/>
                      </StackPanel>
                    </Button>
                  </DataTemplate>

                </ItemsControl.DataTemplates>
              </ItemsControl>
              <Grid IsVisible="{Binding HasWithinReason}" ColumnDefinitions="Auto,*" ColumnSpacing="8"
                    AutomationProperties.Name="{Binding InvalidSpokenName}" AutomationProperties.LiveSetting="Polite">
                <parts:EffectMark Kind="Block" Width="14" Height="14" Shape="{DynamicResource block}" Sign="{DynamicResource on-block}"
                                  VerticalAlignment="Top" Margin="0,3,0,0"/>
                <TextBlock Grid.Column="1" Theme="{StaticResource type-body}" Foreground="{DynamicResource block-ink}" TextWrapping="Wrap"
                           Text="{Binding WithinReason}"/>
              </Grid>
              </StackPanel>
            </Grid>

            <Grid Classes="clause" ColumnDefinitions="90,12,*">
              <TextBlock Theme="{StaticResource type-sentence}" Foreground="{DynamicResource ink-2}"
                         HorizontalAlignment="Right" Text="where"/>
              <StackPanel Grid.Column="2" Spacing="8">
              <ItemsControl ItemsSource="{Binding WhereFlow}" ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <local:TokenFlow ItemSpacing="8" LineSpacing="8"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>

                  <DataTemplate DataType="local:ConditionViewModel" x:DataType="local:ConditionViewModel">
                    <local:ConditionPiece/>
                  </DataTemplate>

                  <DataTemplate DataType="local:AddConditionItem" x:DataType="local:AddConditionItem">
                    <Button Classes="cf second" VerticalAlignment="Bottom" Padding="10,0,13,0" Command="{Binding AddCommand}" ToolTip.Tip="Add a condition"
                            AutomationProperties.Name="Add a condition">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <parts:Icon Data="{StaticResource i-plus}" Width="13" Height="13" StrokeThickness="1.8"
                                    Stroke="{Binding $parent[Button].Foreground}"/>
                        <TextBlock Theme="{StaticResource type-card}" Text="{Binding Text}"/>
                      </StackPanel>
                    </Button>
                  </DataTemplate>

                </ItemsControl.DataTemplates>
              </ItemsControl>
              <Grid IsVisible="{Binding HasWhereReason}" ColumnDefinitions="Auto,*" ColumnSpacing="8"
                    AutomationProperties.Name="{Binding InvalidSpokenName}" AutomationProperties.LiveSetting="Polite">
                <parts:EffectMark Kind="Block" Width="14" Height="14" Shape="{DynamicResource block}" Sign="{DynamicResource on-block}"
                                  VerticalAlignment="Top" Margin="0,3,0,0"/>
                <TextBlock Grid.Column="1" Theme="{StaticResource type-body}" Foreground="{DynamicResource block-ink}" TextWrapping="Wrap"
                           Text="{Binding WhereReason}"/>
              </Grid>
              </StackPanel>
            </Grid>

            <Grid Classes="clause" ColumnDefinitions="90,12,*">
              <Panel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-8,0,-6,0">
                <Button Name="KindButton" Classes="kw" Classes.open="{Binding KindPicker.IsOpen}" Command="{Binding OpenKindCommand}"
                        ToolTip.Tip="Require or forbid" AutomationProperties.Name="{Binding KindSpokenName}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Theme="{StaticResource type-sentence}" Text="{Binding KindWord}"/>
                    <parts:Icon Data="{StaticResource i-down}" Width="13" Height="13" StrokeThickness="1.8"
                                Stroke="{DynamicResource ink-3}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Popup IsOpen="{Binding KindPicker.IsOpen, Mode=TwoWay}" PlacementTarget="{Binding #KindButton}"
                       Placement="BottomEdgeAlignedLeft" VerticalOffset="6" IsLightDismissEnabled="True"
                       ShouldUseOverlayLayer="True" PlacementConstraintAdjustment="SlideX">
                  <local:PickerPanel DataContext="{Binding KindPicker}"/>
                </Popup>
              </Panel>
              <StackPanel Grid.Column="2" Spacing="8">
              <ItemsControl ItemsSource="{Binding RequireItems}" IsVisible="{Binding IsRequire}" ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <local:TokenFlow ItemSpacing="8" LineSpacing="8"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>

                  <DataTemplate DataType="local:ConditionViewModel" x:DataType="local:ConditionViewModel">
                    <local:ConditionPiece/>
                  </DataTemplate>

                  <DataTemplate DataType="local:AddRequirementItem" x:DataType="local:AddRequirementItem">
                    <Button Classes="cf second addrequirement" VerticalAlignment="Bottom" Padding="10,0,13,0" Command="{Binding AddCommand}" ToolTip.Tip="Add a requirement"
                            AutomationProperties.Name="Add a requirement">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <parts:Icon Data="{StaticResource i-plus}" Width="13" Height="13" StrokeThickness="1.8"
                                    Stroke="{Binding $parent[Button].Foreground}"/>
                        <TextBlock Theme="{StaticResource type-card}" Text="and"/>
                      </StackPanel>
                    </Button>
                  </DataTemplate>

                </ItemsControl.DataTemplates>
              </ItemsControl>
              <TextBlock IsVisible="{Binding IsForbid}" Theme="{StaticResource type-sentence}"
                         Foreground="{DynamicResource ink-2}" Text="any artifact that matches"/>
              <Grid IsVisible="{Binding HasRequireReason}" ColumnDefinitions="Auto,*" ColumnSpacing="8"
                    AutomationProperties.Name="{Binding InvalidSpokenName}" AutomationProperties.LiveSetting="Polite">
                <parts:EffectMark Kind="Block" Width="14" Height="14" Shape="{DynamicResource block}" Sign="{DynamicResource on-block}"
                                  VerticalAlignment="Top" Margin="0,3,0,0"/>
                <TextBlock Grid.Column="1" Theme="{StaticResource type-body}" Foreground="{DynamicResource block-ink}" TextWrapping="Wrap"
                           Text="{Binding RequireReason}"/>
              </Grid>
              </StackPanel>
            </Grid>

          </StackPanel>
        </Border>

        <!-- When code breaks it: the choice of what the rule does to a push. It is saved at once and is one value with the
             effect control of the rule's row. -->
        <TextBlock Theme="{StaticResource type-h2}" Margin="0,20,0,10" Text="When code breaks it"/>
        <parts:SegmentedList Classes="segmented large" ItemsSource="{Binding Effects}"
                             SelectedItem="{Binding SelectedEffect, Mode=TwoWay}" AutomationProperties.Name="When code breaks it">
          <parts:SegmentedList.ItemTemplate>
            <DataTemplate DataType="rules:EffectMenuEntry" x:DataType="rules:EffectMenuEntry">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" AutomationProperties.Name="{Binding Label}">
                <parts:EffectMark Classes.block="{Binding IsBlock}" Classes.warn="{Binding !IsBlock}" Kind="{Binding Kind}"
                                  Width="16" Height="16" Margin="0,0,8,0"/>
                <TextBlock Classes="segment" Theme="{StaticResource type-note}" Text="{Binding Label}"/>
                <parts:Icon IsVisible="{Binding IsCurrent}" Data="{StaticResource i-check}" Width="15" Height="15"
                            StrokeThickness="2" Stroke="{DynamicResource ink}" Margin="6,0,0,0"/>
              </StackPanel>
            </DataTemplate>
          </parts:SegmentedList.ItemTemplate>
        </parts:SegmentedList>

        <!-- What a finding says: the message and the reason, two text fields. What the developer reads is a section of its own, after
             the choice of what then happens to the push. -->
        <TextBlock Theme="{StaticResource type-h2}" Margin="0,20,0,10" Text="What a finding says"/>
        <StackPanel Spacing="16">
          <StackPanel Spacing="6">
            <WrapPanel ItemSpacing="8">
              <TextBlock Theme="{StaticResource type-body-strong}" Text="Message"/>
              <TextBlock Theme="{StaticResource type-body}" Foreground="{DynamicResource ink-2}" VerticalAlignment="Center"
                         Text="One sentence. Left empty, a finding says the title."/>
            </WrapPanel>
            <Border Classes="textfield">
              <TextBox Name="MessageBox" Classes="bare" Text="{Binding Message, Mode=TwoWay}" PlaceholderText="{Binding MessagePlaceholder}"
                       Height="NaN" TextWrapping="Wrap" AcceptsReturn="False" FontSize="14" MinHeight="22"
                       AutomationProperties.Name="Message. Left empty, a finding says the title"/>
            </Border>
          </StackPanel>
          <StackPanel Spacing="6">
            <WrapPanel ItemSpacing="8">
              <TextBlock Theme="{StaticResource type-body-strong}" Text="Why"/>
              <TextBlock Theme="{StaticResource type-body}" Foreground="{DynamicResource ink-2}" VerticalAlignment="Center"
                         Text="Shown under the message on an open finding."/>
            </WrapPanel>
            <Border Classes="textfield">
              <TextBox Name="WhyBox" Classes="bare" VerticalContentAlignment="Top" Text="{Binding Why, Mode=TwoWay}"
                       PlaceholderText="Why the team wants this, in a sentence or two."
                       Height="NaN" TextWrapping="Wrap" AcceptsReturn="True" FontSize="14" MinHeight="62" MaxHeight="162" ScrollViewer.VerticalScrollBarVisibility="Auto"
                       AutomationProperties.Name="Why. Shown under the message on an open finding"/>
            </Border>
          </StackPanel>
        </StackPanel>

        <!-- Try it: the code box takes the height the page has left (the view fits it, see RulePageView.FitTryIt). -->
        <local:TryItView Name="TryIt" DataContext="{Binding TryIt}"/>

      </StackPanel>
    </Border>
  </ScrollViewer>

  </Grid>

</UserControl>
