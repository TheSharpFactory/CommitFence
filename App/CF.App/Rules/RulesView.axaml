<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CF.App.Rules"
             xmlns:page="using:CF.App.Rules.Page"
             xmlns:shell="using:CF.App.Shell"
             xmlns:parts="using:CF.App.Parts"
             xmlns:review="using:CF.App.Review"
             xmlns:doctor="using:CF.App.Doctor"
             x:Class="CF.App.Rules.RulesView"
             x:ClassModifier="internal"
             x:DataType="local:RulesViewModel">

  <!-- Rules: the list column, then the page. Two panes from a window 1304 wide, one pane under it,
       where the page comes over the list. -->
  <UserControl.Resources>
    <DataTemplate x:Key="SetupPage" x:DataType="local:RulesViewModel">
      <StackPanel MaxWidth="600" HorizontalAlignment="Stretch">
        <Grid Height="48" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <Border Background="{DynamicResource hover}" CornerRadius="7" Height="24" Padding="7,0,9,0">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <parts:Icon Data="{StaticResource i-set}" Width="12" Height="12" Stroke="{DynamicResource ink-2}"/>
              <TextBlock Theme="{StaticResource type-label}" FontWeight="SemiBold" Foreground="{DynamicResource ink-2}" Text="Setup"/>
            </StackPanel>
          </Border>
          <TextBlock Grid.Column="1" Theme="{StaticResource code-strong}" VerticalAlignment="Center"
                     Text="{Binding SetupRepository}" TextTrimming="CharacterEllipsis"/>
          <StackPanel Grid.Column="2" IsVisible="{Binding !IsStarting}" Orientation="Horizontal" Spacing="8"
                      Margin="0,0,4,0" VerticalAlignment="Center">
            <parts:Icon IsVisible="{Binding ShowsPendingSetupState}" Data="{StaticResource i-circle}" Width="14" Height="14"
                        Stroke="{DynamicResource ink-3}" VerticalAlignment="Center"/>
            <parts:Icon IsVisible="{Binding !NeedsSetup}" Data="{StaticResource i-check}" Width="14" Height="14"
                        Stroke="{DynamicResource req-ink}" VerticalAlignment="Center"/>
            <Ellipse IsVisible="{Binding ShowsFailedSetupState}" Width="8" Height="8" Fill="{DynamicResource block}" VerticalAlignment="Center"/>
            <TextBlock Classes="setup-state" Classes.failed="{Binding ShowsFailedSetupState}"
                       Theme="{StaticResource type-body}" FontWeight="Medium" Text="{Binding SetupState}"/>
          </StackPanel>
        </Grid>
        <TextBlock Theme="{StaticResource type-title}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding SetupHeading}"/>
        <Grid Height="20" Margin="0,2,0,0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <parts:Icon Data="{StaticResource i-file}" Width="14" Height="14" Stroke="{DynamicResource ink-3}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Theme="{StaticResource type-body}" Foreground="{DynamicResource ink-2}" TextTrimming="CharacterEllipsis"
                     Text="{Binding SetupReservedLine}"/>
        </Grid>
        <TextBlock IsVisible="{Binding NeedsSetup}" Theme="{StaticResource type-body}" Foreground="{DynamicResource ink-2}"
                   Margin="0,14,0,0" TextWrapping="Wrap"
                   Text="Starting here writes commitfence.json with no rules yet. Nothing else in the repository changes."/>
        <Grid IsVisible="{Binding !NeedsSetup}" Margin="0,16,0,0" ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <Border Width="20" Height="20" CornerRadius="6" VerticalAlignment="Top" Background="{DynamicResource req-ink}">
            <parts:Icon Data="{StaticResource i-check}" Width="12" Height="12" StrokeThickness="2.8" Stroke="{DynamicResource page}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Grid.Column="1" Theme="{StaticResource type-body}" TextWrapping="Wrap"
                     AutomationProperties.Name="{Binding SetupConfirmation}" AutomationProperties.LiveSetting="Polite">
            <Run Text="{Binding SetupConfirmation}" FontWeight="SemiBold"/><Run Text="{Binding SetupWhen}" Foreground="{DynamicResource ink-2}"/>
          </TextBlock>
        </Grid>
        <Border Margin="0,20,0,0" BorderBrush="{DynamicResource line}" BorderThickness="1"
                CornerRadius="16" ClipToBounds="True" AutomationProperties.Name="commitfence.json: {, &quot;rules&quot;: [], }">
          <StackPanel>
            <Border MinHeight="40" Padding="16,6" Background="{DynamicResource well}" BorderBrush="{DynamicResource line}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                <parts:Icon Data="{StaticResource i-file}" Width="16" Height="16" Stroke="{DynamicResource ink-2}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Theme="{StaticResource code-strong}" Text="commitfence.json" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}" VerticalAlignment="Center"
                           Text="{Binding SettingsLocation}" TextWrapping="Wrap"/>
                <Button Grid.Column="3" Classes="cf outlined small" IsVisible="{Binding !NeedsSetup}"
                        Command="{Binding OpenSettingsFileCommand}" AutomationProperties.Name="Open file">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <parts:Icon Data="{StaticResource i-open}" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}"/>
                    <TextBlock Theme="{StaticResource type-meta-strong}" Text="Open file"/>
                  </StackPanel>
                </Button>
                <Panel Grid.Column="3" IsVisible="{Binding SetupError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <review:CopyButton IsCompact="True" DataContext="{Binding CopyStarter}"/>
                </Panel>
              </Grid>
            </Border>
            <parts:FileLines Margin="0,8" ItemsSource="{Binding StarterLines}" NumberWidth="30" NumberGap="14"/>
          </StackPanel>
        </Border>
        <Grid IsVisible="{Binding SetupError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,16,0,0">
          <parts:EffectMark Kind="Block" Width="14" Height="14" VerticalAlignment="Top" Margin="0,3,0,0"
                            Shape="{DynamicResource block}" Sign="{DynamicResource on-block}"/>
          <doctor:DoctorTextBlock Grid.Column="1" Classes="error" Theme="{StaticResource type-body}"
                                  Foreground="{DynamicResource block-ink}" Parts="{Binding SetupErrorParts}"
                                  FailureDetail="{Binding SetupErrorDetail}" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
        <parts:BusyButton IsVisible="{Binding NeedsSetup}" Classes="cf main" Width="232" HorizontalAlignment="Left" Margin="0,16,0,0"
                          IsBusy="{Binding IsStarting}" Command="{Binding StartSettingsCommand}" AutomationProperties.Name="{Binding StartName}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <parts:Icon IsVisible="{Binding ShowsStartIcon}" Data="{StaticResource i-plus}" Width="16" Height="16"
                        Stroke="{Binding $parent[Button].Foreground}"/>
            <parts:Icon IsVisible="{Binding ShowsFailedSetupState}" Data="{StaticResource i-refresh}" Width="16" Height="16"
                        Stroke="{Binding $parent[Button].Foreground}"/>
            <parts:TurningRing Classes="button-ring on-solid" VerticalAlignment="Center" IsVisible="{Binding IsStarting}"/>
            <TextBlock Theme="{StaticResource type-body-strong}" Text="{Binding StartLabel}"/>
          </StackPanel>
        </parts:BusyButton>
        <Panel IsVisible="{Binding !NeedsSetup}" Margin="0,20,0,0">
          <parts:SetupNextStepView DataContext="{Binding CommitSettings}"/>
        </Panel>
        <StackPanel IsVisible="{Binding !NeedsSetup}" Margin="0,28,0,0">
          <TextBlock Theme="{StaticResource type-h2}" Text="No rules yet"/>
          <TextBlock Theme="{StaticResource type-body}" Foreground="{DynamicResource ink-2}" MaxWidth="600" HorizontalAlignment="Left"
                     Margin="0,8,0,12" TextWrapping="Wrap"
                     Text="A rule is a sentence. Write the first one with New rule, at the top of the list. One reads like this:"/>
          <Border Background="{DynamicResource well}" CornerRadius="16" Padding="20,16,20,10" Margin="0,4,0,0"
                  AutomationProperties.Name="{Binding SpecimenSpokenName}">
            <review:SentencePieces Pieces="{Binding Specimen}" IsHitTestVisible="False"/>
          </Border>
        </StackPanel>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.DataTemplates>
    <DataTemplate DataType="local:GroupHeadingViewModel" x:DataType="local:GroupHeadingViewModel">
      <Border Height="44" BorderBrush="{DynamicResource line}" BorderThickness="0,0,0,1" Padding="4,0"
              AutomationProperties.Name="{Binding SpokenName}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
          <Button Classes="cf quiet" Height="32" CornerRadius="8" Padding="6,0,8,0" Focusable="False"
                  Command="{Binding ToggleFoldCommand}" AutomationProperties.Name="{Binding SpokenName}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <parts:Icon Classes="fold-arrow" Classes.folded="{Binding !IsExpanded}"
                          Data="{StaticResource i-down}" Width="14" Height="14" Stroke="{DynamicResource ink-3}"/>
              <parts:Icon IsVisible="{Binding IsCustom}" Data="{StaticResource i-pen}" Width="14" Height="14"
                          Stroke="{DynamicResource ink-2}"/>
              <parts:Icon IsVisible="{Binding IsEditorConfig}" Data="{StaticResource i-file}" Width="14" Height="14"
                          Stroke="{DynamicResource ink-2}"/>
              <TextBlock Classes="group-name" Theme="{StaticResource type-body-strong}" Text="{Binding Name}"/>
              <TextBlock Classes="group-count" Theme="{StaticResource type-body}" FontFeatures="+tnum"
                         IsVisible="{Binding ShowsCount}" Text="{Binding Count}"/>
            </StackPanel>
          </Button>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <parts:Icon IsVisible="{Binding NoteHasLock}" Data="{StaticResource i-lock-line}" Width="13" Height="13"
                        Stroke="{DynamicResource ink-3}"/>
            <TextBlock Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding Note}"/>
          </StackPanel>
          <Button Grid.Column="2" Classes="cf outlined small" IsVisible="{Binding HasOpenFile}" Command="{Binding OpenFileCommand}"
                  AutomationProperties.Name="Open file">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <parts:Icon Data="{StaticResource i-open}" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}"/>
              <TextBlock Theme="{StaticResource type-meta-strong}" Text="Open file"/>
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>

  <UserControl.Styles>
    <Style Selector="TextBlock.setup-state">
      <Setter Property="Foreground" Value="{DynamicResource ink-2}"/>
    </Style>
    <Style Selector="TextBlock.setup-state.failed">
      <Setter Property="Foreground" Value="{DynamicResource block-ink}"/>
    </Style>
    <Style Selector="Grid#Head TextBlock#MessageText">
      <Setter Property="MaxWidth" Value="{Binding $parent[Grid].Bounds.Width}"/>
    </Style>
    <Style Selector="Grid#RowRoot">
      <Setter Property="Margin" Value="12"/>
    </Style>
    <Style Selector="Grid#RowRoot.scoped">
      <Setter Property="Margin" Value="12,12,12,8"/>
    </Style>
    <Style Selector="ListBoxItem.draft-rule" x:DataType="local:DraftRuleRowViewModel">
      <Setter Property="AutomationProperties.Name" Value="{Binding Page.DraftSpokenName}"/>
    </Style>
    <Style Selector="ListBoxItem.file-rule" x:DataType="local:FileRuleRowViewModel">
      <Setter Property="AutomationProperties.Name" Value="{Binding SpokenName}"/>
    </Style>
    <Style Selector="ListBoxItem.heading" x:DataType="local:GroupHeadingViewModel">
      <Setter Property="AutomationProperties.Name" Value="{Binding SpokenName}"/>
    </Style>
    <Style Selector="local|FilePlacePattern">
      <Setter Property="AutomationProperties.AccessibilityView" Value="Raw"/>
    </Style>
    <Style Selector="Grid.dimmed parts|EffectMark">
      <Setter Property="Shape" Value="{DynamicResource ink-3}"/>
      <Setter Property="Sign" Value="{DynamicResource side}"/>
    </Style>
    <Style Selector="TextBlock.place-where">
      <Setter Property="Foreground" Value="{DynamicResource ink-2}"/>
    </Style>
    <Style Selector="Grid.dimmed TextBlock.place-effect, Grid.dimmed TextBlock.place-where, Grid.dimmed local|FilePlacePattern TextBlock#Text">
      <Setter Property="Foreground" Value="{DynamicResource ink-3}"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style Selector="Grid.dimmed Button.linelink:not(:pointerover):not(.ring)">
      <Setter Property="Foreground" Value="{DynamicResource ink-3}"/>
    </Style>

    <!-- The container of every entry of the list: a row, a heading or a line of words. Rest: no background; under the pointer
         hover; pressed line; selected page with the raised shadow and a bar of here. The ring is a line of 2 inside the edge. -->
    <Style Selector="ListBox.rules ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border Name="Surface" CornerRadius="12" Background="Transparent">
              <ContentPresenter Name="ContentHost" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch"/>
            </Border>
            <Border Name="Bar" IsHitTestVisible="False" Width="4" CornerRadius="2" HorizontalAlignment="Left"
                    Margin="0,10" Background="{DynamicResource here}" RenderTransform="scaleY(0)">
              <Border.Transitions>
                <Transitions>
                  <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="{x:Static parts:CubicBezierEasing.Spring}"/>
                </Transitions>
              </Border.Transitions>
            </Border>
            <Border Name="Ring" IsVisible="False" IsHitTestVisible="False" CornerRadius="12" BorderThickness="2"
                    BorderBrush="{DynamicResource focus}"/>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.rules ListBoxItem:pointerover /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource hover}"/>
    </Style>
    <Style Selector="ListBox.rules ListBoxItem:pressed /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource line}"/>
    </Style>
    <Style Selector="ListBox.rules ListBoxItem:selected /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource page}"/>
      <Setter Property="BoxShadow" Value="{DynamicResource shadow-raised}"/>
    </Style>
    <Style Selector="ListBox.rules ListBoxItem:selected /template/ Border#Bar">
      <Setter Property="RenderTransform" Value="scaleY(1)"/>
    </Style>
    <Style Selector="ListBox.rules ListBoxItem.ring /template/ Border#Ring">
      <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- A heading and a note are not raised, and not drawn pressed or selected. -->
    <Style Selector="ListBox.rules ListBoxItem.heading /template/ Border#Surface">
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BoxShadow" Value="none"/>
    </Style>
    <Style Selector="ListBox.rules ListBoxItem.heading /template/ Border#Bar">
      <Setter Property="RenderTransform" Value="scaleY(0)"/>
    </Style>
    <Style Selector="ListBox.rules ListBoxItem.note /template/ Border#Surface">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BoxShadow" Value="none"/>
    </Style>
    <Style Selector="ListBox.rules ListBoxItem.note /template/ Border#Bar">
      <Setter Property="RenderTransform" Value="scaleY(0)"/>
    </Style>
    <Style Selector="ListBox.rules ListBoxItem.note">
      <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style Selector="ListBox.rules ListBoxItem.note:not(.setup)">
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style Selector="Button.rulehead">
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <!-- In one pane the rows are never wider than the list of two panes plus the arrow, sit in the middle of the pane, and none
         is drawn selected. -->
    <Style Selector="ListBox.rules.onepane ListBoxItem">
      <Setter Property="MaxWidth" Value="663"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ListBox.rules.onepane ListBoxItem:selected /template/ Border#Surface">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BoxShadow" Value="none"/>
    </Style>
    <Style Selector="ListBox.rules.onepane ListBoxItem:selected /template/ Border#Bar">
      <Setter Property="RenderTransform" Value="scaleY(0)"/>
    </Style>
    <Style Selector="ListBox.rules.onepane ListBoxItem:selected:pointerover /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource hover}"/>
    </Style>

    <!-- The title of a rule that is off: weight 400 in ink-2. -->
    <Style Selector="TextBlock.rule-title.off">
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Foreground" Value="{DynamicResource ink-2}"/>
    </Style>

    <!-- The line of the file in the row of a file rule: a link. At rest "line 378" in ink-3; under the pointer ink, underlined.
         The ring is a line of 2 round the area that takes the click. -->
    <!-- The copy of a heading that is held over the top of the list takes no keyboard: the heading in the list has the stop. -->
    <Style Selector="ContentControl#StickyHeading Button">
      <Setter Property="Focusable" Value="False"/>
    </Style>
    <!-- The groups' fold arrow turns a quarter towards the left while folded (motion 11). -->
    <Style Selector="parts|Icon.fold-arrow">
      <Setter Property="RenderTransform" Value="rotate(0deg)"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="{x:Static parts:CubicBezierEasing.Standard}"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="parts|Icon.fold-arrow.folded">
      <Setter Property="RenderTransform" Value="rotate(-90deg)"/>
    </Style>
    <Style Selector="TextBlock.group-name">
      <Setter Property="Foreground" Value="{DynamicResource ink}"/>
    </Style>
    <Style Selector="TextBlock.group-count">
      <Setter Property="Foreground" Value="{DynamicResource ink-3}"/>
    </Style>

    <!-- An entry of the menu of an effect: 36 high, radius 8; hover is for the pointer and the keyboard, the tick for the
         entry in force. -->
    <Style Selector="Button.menu-entry">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Surface" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.menu-entry:pointerover /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource hover}"/>
    </Style>
    <Style Selector="Button.menu-entry.highlight /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource hover}"/>
    </Style>
    <Style Selector="Button.menu-entry TextBlock.entry-label.current">
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- The search field: a frame of 36 high; hover border line-strong; focused border 2 in focus, drawn inside so nothing
         moves. The text box inside has no frame of its own. -->
    <Style Selector="Border.search:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource line-strong}"/>
    </Style>
    <Style Selector="Border.search:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource focus}"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Padding" Value="11,0"/>
    </Style>

  </UserControl.Styles>

  <Grid Name="Columns" ColumnDefinitions="656,*">

    <!-- The list column: side, a hairline on its right. The top 36 is the title strip. -->
    <Border Name="ListColumn" Grid.Column="0" Background="{DynamicResource side}" BorderBrush="{DynamicResource line}"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="36,Auto,Auto,Auto,Auto,*">

        <!-- The settings file cannot be read or written: the reason, and a way to open the file. -->
        <Border Grid.Row="1" IsVisible="{Binding HasBanner}" MaxWidth="684" Margin="16,0,16,12" Padding="14,10"
                CornerRadius="12" Background="{DynamicResource warn-tint}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Theme="{StaticResource type-body}" Text="{Binding BannerText}" TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" Classes="cf quiet small" IsVisible="{Binding CanOpenSettingsFile}"
                    Command="{Binding OpenSettingsFileCommand}" AutomationProperties.Name="Open the file">
              <TextBlock Theme="{StaticResource type-meta-strong}" Text="Open the file"/>
            </Button>
          </Grid>
        </Border>

        <!-- A rule was removed: its id, and a way to bring it back. It goes after 10 seconds or on Undo. -->
        <Border Grid.Row="2" IsVisible="{Binding HasUndo}" MaxWidth="684" Margin="16,0,16,12" Padding="14,6,8,6"
                CornerRadius="12" Background="{DynamicResource warn-tint}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Theme="{StaticResource type-body}" Text="{Binding UndoText}" VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"/>
            <Button Grid.Column="1" Classes="cf quiet small" Command="{Binding UndoRemoveCommand}" AutomationProperties.Name="Undo">
              <TextBlock Theme="{StaticResource type-meta-strong}" Text="Undo"/>
            </Button>
          </Grid>
        </Border>

        <!-- The head: the name of the screen and New rule. -->
        <Grid Grid.Row="3" MaxWidth="684" Margin="16,4,16,12" ColumnDefinitions="Auto,*">
          <TextBlock Theme="{StaticResource type-h1}" Text="Rules" VerticalAlignment="Center"/>
          <Button Name="NewRuleButton" Grid.Column="1" Classes="cf rulehead" Classes.main="{Binding !NeedsSetup}" Classes.outlined="{Binding NeedsSetup}"
                  Command="{Binding NewRuleFromHeadCommand}"
                  AutomationProperties.Name="New rule">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <parts:Icon Data="{StaticResource i-plus}" Width="16" Height="16"
                          Stroke="{Binding $parent[Button].Foreground}"/>
              <TextBlock Theme="{StaticResource type-body-strong}" Text="New rule"/>
            </StackPanel>
          </Button>
        </Grid>

        <!-- The tools: the search, then the filter, as wide as the search. -->
        <StackPanel Grid.Row="4" MaxWidth="684" Margin="16,0,16,12" Spacing="10">
          <Border Classes="search" Height="36" CornerRadius="12" Background="{DynamicResource page}"
                  BorderBrush="{DynamicResource line}" BorderThickness="1" Padding="12,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <parts:Icon Data="{StaticResource i-search}" Width="16" Height="16" Stroke="{DynamicResource ink-3}"/>
              <TextBox Name="Search" Grid.Column="1" Classes="bare" Text="{Binding SearchText, Mode=TwoWay}"
                       PlaceholderText="Search by id or title" AutomationProperties.Name="Search by id or title"
                       KeyDown="OnSearchKeyDown"/>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <Border IsVisible="{Binding ShowsSearchHint}" BorderBrush="{DynamicResource line-strong}"
                        BorderThickness="1" CornerRadius="4" Padding="5,0" IsHitTestVisible="False">
                  <TextBlock Theme="{StaticResource type-label}" FontWeight="Medium" Foreground="{DynamicResource ink-3}"
                             Text="Ctrl+F"/>
                </Border>
                <Button Classes="cf quiet round" IsVisible="{Binding HasSearchText}" Command="{Binding ClearSearchCommand}"
                        AutomationProperties.Name="Clear the search">
                  <parts:Icon Data="{StaticResource i-x}" Width="12" Height="12"
                              Stroke="{Binding $parent[Button].Foreground}"/>
                </Button>
              </Panel>
            </Grid>
          </Border>
          <parts:SegmentedList Classes="segmented" ItemsSource="{Binding Filters}"
                               SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                               AutomationProperties.Name="Show rules by what they do to a push">
            <parts:SegmentedList.ItemTemplate>
              <DataTemplate DataType="local:FilterSegmentViewModel" x:DataType="local:FilterSegmentViewModel">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" AutomationProperties.Name="{Binding SpokenName}">
                  <parts:EffectMark Classes="block" Kind="Block" Width="14" Height="14" Margin="0,0,6,0"
                                    IsVisible="{Binding ShowsBlockMark}"/>
                  <parts:EffectMark Classes="warn" Kind="Warn" Width="14" Height="14" Margin="0,0,6,0"
                                    IsVisible="{Binding ShowsWarnMark}"/>
                  <parts:Icon Data="{StaticResource i-off}" Width="14" Height="14" Margin="0,0,6,0"
                              Stroke="{DynamicResource ink-2}" IsVisible="{Binding ShowsOffMark}"/>
                  <TextBlock Classes="segment" Theme="{StaticResource type-body}" Text="{Binding Label}"/>
                  <TextBlock Classes="segment-count" Theme="{StaticResource type-body}" Margin="6,0,0,0"
                             FontFeatures="+tnum" Text="{Binding CountText}"/>
                </StackPanel>
              </DataTemplate>
            </parts:SegmentedList.ItemTemplate>
          </parts:SegmentedList>
        </StackPanel>

        <!-- The list of rules: one recycling list of headings and rows. Padding 0 12 12 8. -->
        <Panel Grid.Row="5" ClipToBounds="True">
          <local:RuleListBox Name="Rows" Classes="rules" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             IsOnePane="{Binding IsOnePane}" Classes.onepane="{Binding IsOnePane}"
                             IsVisible="{Binding !HasNoMatch}"
                             Padding="8,0,12,12" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             ScrollViewer.AllowAutoHide="False"
                             AutomationProperties.Name="Rules">
            <local:RuleListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel/>
              </ItemsPanelTemplate>
            </local:RuleListBox.ItemsPanel>
            <local:RuleListBox.DataTemplates>

              <DataTemplate DataType="local:GroupNoteViewModel" x:DataType="local:GroupNoteViewModel">
                <Border Padding="12,8">
                  <Panel>
                    <TextBlock IsVisible="{Binding IsPlain}" Theme="{StaticResource type-body}"
                               Foreground="{DynamicResource ink-2}" Text="{Binding Text}"/>
                    <TextBlock IsVisible="{Binding FollowsFilter}" Theme="{StaticResource type-meta}"
                               Foreground="{DynamicResource ink-2}" Text="{Binding Text}"/>
                    <Panel IsVisible="{Binding OffersSetup}">
                      <Panel IsVisible="{Binding Setup.IsOnePane}">
                        <ContentControl IsVisible="{Binding Setup.ShowsSetup}" Content="{Binding Setup}" ContentTemplate="{StaticResource SetupPage}"/>
                        <TextBlock IsVisible="{Binding !Setup.ShowsSetup}" Theme="{StaticResource type-body}"
                                   Foreground="{DynamicResource ink-2}" Text="No custom rules yet."/>
                      </Panel>
                      <Panel IsVisible="{Binding !Setup.IsOnePane}">
                        <TextBlock IsVisible="{Binding Setup.NeedsSetup}" Theme="{StaticResource type-body}"
                                   Foreground="{DynamicResource ink-2}" Text="{Binding Text}"/>
                        <TextBlock IsVisible="{Binding !Setup.NeedsSetup}" Theme="{StaticResource type-body}"
                                   Foreground="{DynamicResource ink-2}" Text="No custom rules yet."/>
                      </Panel>
                    </Panel>
                  </Panel>
                </Border>
              </DataTemplate>

              <DataTemplate DataType="local:DraftRuleRowViewModel" x:DataType="local:DraftRuleRowViewModel">
                <Grid Margin="12,12,12,8" ColumnDefinitions="56,*,148,Auto" RowDefinitions="Auto,Auto"
                      AutomationProperties.AccessibilityView="Raw">
                  <TextBlock IsVisible="{Binding Page.HasId}" Theme="{StaticResource code}" Foreground="{DynamicResource ink-2}"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Page.Id}"/>
                  <TextBlock IsVisible="{Binding !Page.HasId}" Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-3}" Text="no ID"/>
                  <TextBlock Grid.Column="1" Margin="12,0,0,0" IsVisible="{Binding Page.HasTitle}" Theme="{StaticResource type-body-strong}"
                             TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Text="{Binding Page.Title}"/>
                  <TextBlock Grid.Column="1" Margin="12,0,0,0" IsVisible="{Binding !Page.HasTitle}" Theme="{StaticResource type-body}"
                             Foreground="{DynamicResource ink-3}" Text="Name the rule"/>
                  <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="5" Height="20" Margin="12,4,0,0">
                    <Border IsVisible="{Binding !Page.ArtifactIsEmpty}" Background="{DynamicResource for}" CornerRadius="6" Padding="7,0">
                      <TextBlock Theme="{StaticResource type-label}" Foreground="{DynamicResource for-ink}" VerticalAlignment="Center" Text="{Binding Page.ArtifactWords}"/>
                    </Border>
                    <TextBlock IsVisible="{Binding !Page.ArtifactIsEmpty}" Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}"
                               VerticalAlignment="Center" Text="in"/>
                    <Border Background="{DynamicResource for}" CornerRadius="6" Padding="7,0">
                      <TextBlock Theme="{StaticResource type-label}" Foreground="{DynamicResource for-ink}" VerticalAlignment="Center" Text="{Binding Page.LanguageText}"/>
                    </Border>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="4,2,0,0">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource ink}" VerticalAlignment="Center"/>
                    <TextBlock Theme="{StaticResource type-meta-strong}" Text="Not saved yet"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>

              <!-- The row of a team rule: id, title and what it is for, the effect control, the switch. Four columns 12 apart:
                   56, the rest, 84, 52; in one pane a fifth, 16, with the arrow that opens the rule. -->
              <DataTemplate DataType="local:TeamRuleRowViewModel" x:DataType="local:TeamRuleRowViewModel">
                <Grid Name="RowRoot" Margin="12,12,12,8" ColumnDefinitions="56,*,96,64,Auto" RowDefinitions="Auto,Auto"
                      AutomationProperties.Name="{Binding SpokenName}">

                  <Border Grid.ColumnSpan="5" Grid.RowSpan="2" Margin="-12,-12,-12,-8" IsVisible="{Binding HasIdClash}"
                          IsHitTestVisible="False" BorderBrush="{DynamicResource block}" BorderThickness="2" CornerRadius="12"/>
                  <TextBlock Grid.Column="0" Theme="{StaticResource code}" TextWrapping="NoWrap">
                    <Run Text="{Binding IdFamily}" FontWeight="SemiBold"/><Run Text="{Binding IdNumber}" Foreground="{DynamicResource ink-2}"/>
                  </TextBlock>

                  <TextBlock Grid.Column="1" Classes="rule-title" Classes.off="{Binding RuleIsOff}"
                             Theme="{StaticResource type-body-strong}" Margin="12,0,0,0" TextWrapping="Wrap" MaxLines="2"
                             TextTrimming="CharacterEllipsis" Text="{Binding Title}" ToolTip.Tip="{Binding Title}"/>

                  <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="5" Height="20" Margin="12,4,0,0">
                    <Border Background="{DynamicResource for}" CornerRadius="6" Height="20" Padding="7,0">
                      <TextBlock Theme="{StaticResource type-label}" Foreground="{DynamicResource for-ink}"
                                 VerticalAlignment="Center" Text="{Binding ArtifactText}"/>
                    </Border>
                    <TextBlock Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}"
                               VerticalAlignment="Center" Text="in"/>
                    <Border Background="{DynamicResource for}" CornerRadius="6" Height="20" Padding="7,0">
                      <TextBlock Theme="{StaticResource type-label}" Foreground="{DynamicResource for-ink}"
                                 VerticalAlignment="Center" Text="{Binding LanguageText}"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="5,0,0,0" IsVisible="{Binding HasIdClash}"
                                AutomationProperties.AccessibilityView="Raw">
                      <parts:EffectMark Classes="block" Kind="Block" Width="13" Height="13" VerticalAlignment="Center"/>
                      <TextBlock Theme="{StaticResource type-meta}" Foreground="{DynamicResource block-ink}"
                                 VerticalAlignment="Center" Text="Same ID as the new rule"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="5,0,0,0" IsVisible="{Binding ShowsUnsaved}">
                      <Ellipse Width="7" Height="7" Fill="{DynamicResource ink}" VerticalAlignment="Center"/>
                      <TextBlock Theme="{StaticResource type-meta}" FontWeight="Medium" Foreground="{DynamicResource ink}"
                                 VerticalAlignment="Center" Text="Unsaved"/>
                    </StackPanel>
                  </StackPanel>

                  <Button Name="EffectButton" Grid.Column="2" Grid.RowSpan="2" Classes="effect" Classes.ring="{Binding RingOnEffect}"
                          Classes.open="{Binding IsEffectMenuOpen}" Width="92" Height="36" HorizontalAlignment="Left"
                          VerticalAlignment="Top" Margin="6,-8,0,0" Command="{Binding ToggleEffectMenuCommand}"
                          IsVisible="{Binding !RuleIsOff}" AutomationProperties.Name="{Binding EffectSpokenName}">
                    <DockPanel LastChildFill="False" VerticalAlignment="Center">
                      <parts:Icon DockPanel.Dock="Right" Data="{StaticResource i-down}" Width="11" Height="11"
                                  StrokeThickness="1.8" Stroke="{DynamicResource ink-3}" Margin="0,0,1,0"/>
                      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6" Margin="1,0,0,0">
                        <parts:EffectMark Classes.block="{Binding MarkIsBlock}" Classes.warn="{Binding MarkIsWarn}"
                                          Kind="{Binding EffectKind}" Width="14" Height="14"/>
                        <TextBlock Theme="{StaticResource type-effect}" Text="{Binding EffectWord}"/>
                      </StackPanel>
                    </DockPanel>
                  </Button>

                  <!-- A rule that is off says so as a statement ("Off", not a control) and, under it, the control that holds what it
                       would do when it is on. -->
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Height="20" VerticalAlignment="Top" Margin="13,0,0,0"
                              IsVisible="{Binding RuleIsOff}">
                    <parts:Icon Data="{StaticResource i-off}" Width="14" Height="14" Stroke="{DynamicResource off}" VerticalAlignment="Center"/>
                    <TextBlock Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}" VerticalAlignment="Center" Text="Off"/>
                  </StackPanel>
                  <Button Name="OffEffectButton" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Classes="effect" Classes.ring="{Binding RingOnEffect}"
                          Classes.open="{Binding IsEffectMenuOpen}" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,2,0,-2"
                          Command="{Binding ToggleEffectMenuCommand}" IsVisible="{Binding RuleIsOff}" AutomationProperties.Name="{Binding EffectSpokenName}">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="1,0,0,0">
                      <TextBlock Theme="{StaticResource type-effect}" FontWeight="Normal" Foreground="{DynamicResource ink-2}" Text="{Binding OffEffectWord}"/>
                      <parts:Icon Data="{StaticResource i-down}" Width="11" Height="11" StrokeThickness="1.8" Stroke="{DynamicResource ink-3}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>

                  <ToggleButton Grid.Column="3" Grid.RowSpan="2" Classes="cfswitch" Classes.ring="{Binding RingOnSwitch}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,0,0"
                                IsChecked="{Binding IsOn, Mode=OneWay}" Command="{Binding ToggleSwitchCommand}"
                                AutomationProperties.Name="{Binding SwitchSpokenName}"/>

                  <parts:Icon Grid.Column="4" Grid.RowSpan="2" Data="{StaticResource i-right}" Width="16" Height="16" Margin="12,2,0,0"
                              VerticalAlignment="Top" Stroke="{DynamicResource ink-3}"
                              IsVisible="{Binding $parent[local:RuleListBox].IsOnePane}"/>

                  <!-- The menu of the effect opens in the overlay layer, 4 under the row, its right edge in line with the
                       control's. -->
                  <Popup IsOpen="{Binding IsEffectMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding #RowRoot}"
                         Placement="BottomEdgeAlignedRight" VerticalOffset="12"
                         HorizontalOffset="{Binding $parent[local:RuleListBox].IsOnePane, Converter={x:Static local:MenuOffset.Horizontal}}"
                         IsLightDismissEnabled="True" ShouldUseOverlayLayer="True">
                    <Border Width="344" Background="{DynamicResource page}" BorderBrush="{DynamicResource line-strong}"
                            BorderThickness="1" CornerRadius="12" Padding="6" BoxShadow="{DynamicResource shadow-popup}">
                      <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="local:EffectMenuEntry" x:DataType="local:EffectMenuEntry">
                            <Button Classes="menu-entry" Classes.highlight="{Binding IsHighlighted}"
                                    Command="{Binding $parent[ItemsControl].((local:TeamRuleRowViewModel)DataContext).ChooseCommand}"
                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}">
                              <Grid ColumnDefinitions="Auto,*,16" ColumnSpacing="8">
                                <parts:EffectMark Classes.block="{Binding IsBlock}" Classes.warn="{Binding !IsBlock}"
                                                  Kind="{Binding Kind}" Width="14" Height="14"/>
                                <TextBlock Grid.Column="1" Classes="entry-label" Classes.current="{Binding IsCurrent}"
                                           Theme="{StaticResource type-body}" Text="{Binding Label}"/>
                                <parts:Icon Grid.Column="2" IsVisible="{Binding IsCurrent}" Data="{StaticResource i-check}"
                                            Width="14" Height="14" Stroke="{DynamicResource ink}"/>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </Popup>
                </Grid>
              </DataTemplate>

              <!-- File rows grow to fit the narrower settings beneath the title. -->
              <DataTemplate DataType="local:FileRuleRowViewModel" x:DataType="local:FileRuleRowViewModel">
                <Grid Name="RowRoot" Classes.scoped="{Binding HasDetails}" RowDefinitions="Auto,Auto" ColumnDefinitions="56,*,96,64,Auto">

                  <TextBlock Grid.Column="0" AutomationProperties.AccessibilityView="Raw" Theme="{StaticResource code}" TextWrapping="NoWrap">
                    <Run Text="{Binding IdFamily}" FontWeight="SemiBold"/><Run Text="{Binding IdNumber}" Foreground="{DynamicResource ink-2}"/>
                  </TextBlock>

                  <TextBlock Grid.Column="1" Classes="rule-title" AutomationProperties.AccessibilityView="Raw" Classes.off="{Binding RuleIsOff}"
                             Theme="{StaticResource type-body-strong}" LineHeight="20" Margin="12,0,0,0" TextWrapping="Wrap" MaxLines="2"
                             TextTrimming="CharacterEllipsis" Text="{Binding Title}" ToolTip.Tip="{Binding Title}"/>

                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0" Height="20" VerticalAlignment="Top"
                              IsVisible="{Binding ShowsEffect}">
                    <parts:EffectMark Classes.block="{Binding MarkIsBlock}" Classes.warn="{Binding MarkIsWarn}" Classes.off="{Binding MarkIsOff}"
                                      IsVisible="{Binding !Varies}" Kind="{Binding EffectKind}" Width="14" Height="14" VerticalAlignment="Center"/>
                    <parts:Icon IsVisible="{Binding Varies}" Data="{StaticResource i-varies}" FillData="{StaticResource i-varies-fill}"
                                Stroke="{DynamicResource ink-2}" Width="14" Height="14" VerticalAlignment="Center"/>
                    <TextBlock Theme="{StaticResource type-effect}" Text="{Binding EffectWord}" AutomationProperties.AccessibilityView="Raw"/>
                  </StackPanel>

                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="16,3,0,0"
                              VerticalAlignment="Top" IsVisible="{Binding IsOffInFile}" ToolTip.Tip="{Binding OffToolTip}">
                    <parts:EffectMark Classes="off" Kind="Off" Width="14" Height="14"/>
                    <TextBlock Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"
                               Text="Off"/>
                  </StackPanel>

                  <TextBlock Grid.Column="2" Theme="{StaticResource type-meta}" AutomationProperties.AccessibilityView="Raw" Foreground="{DynamicResource ink-2}"
                             Margin="16,1,0,0" VerticalAlignment="Top" TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding ShowsStateWord}" Text="{Binding StateWord}" ToolTip.Tip="{Binding StateToolTip}"/>

                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="16,3,0,0"
                              VerticalAlignment="Top" IsVisible="{Binding IsUnset}" ToolTip.Tip="{Binding UnsetTip}">
                    <parts:EffectMark Classes="off" Kind="Unset" Width="14" Height="14"/>
                    <TextBlock Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}" Text="Not set" AutomationProperties.AccessibilityView="Raw"/>
                  </StackPanel>
                  <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="12,4,0,0"
                             IsVisible="{Binding IsScopedOnly}" AutomationProperties.AccessibilityView="Raw">
                    <local:FileEffectText Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink-2}"
                                          Scopes="{Binding OtherEffects}" TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw"/>
                  </DockPanel>

                  <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="12,4,0,0"
                              IsVisible="{Binding HasPlaces}">
                    <ItemsControl ItemsSource="{Binding VisiblePlaces}" ClipToBounds="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="local:FileRowPlace" x:DataType="local:FileRowPlace">
                          <Grid Height="24" Classes.dimmed="{Binding IsDimmed}" ColumnDefinitions="*,96,64">
                            <Grid Name="PlaceWords" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="5" VerticalAlignment="Center"
                                  AutomationProperties.AccessibilityView="Raw">
                              <parts:EffectMark Kind="{Binding Kind}" Classes.block="{Binding IsBlock}" Classes.warn="{Binding IsWarn}" Classes.off="{Binding IsOff}" Width="12" Height="12" VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="1" Classes="place-effect" Theme="{StaticResource type-effect}" Text="{Binding Effect}"/>
                              <TextBlock Grid.Column="2" Classes="place-where" Theme="{StaticResource type-meta}" Text="{Binding Where}"/>
                              <local:FilePlacePattern Grid.Column="3" IsVisible="{Binding !IsEverywhereElse}" Classes="compact"
                                                      Values="{Binding Pattern}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                            <Button Grid.Column="2" Classes="linelink" Classes.ring="{Binding IsFocused}" Name="PlaceLine"
                                    shell:ToolTipBehavior.LineLink="True" shell:ToolTipBehavior.LineWords="{Binding #PlaceWords}"
                                    shell:ToolTipBehavior.RowFocus="{Binding IsFocused}" AutomationProperties.Name="{Binding LinkName}"
                                    Margin="0,0,-6,0" HorizontalAlignment="Right" Focusable="False" Command="{Binding OpenCommand}">
                              <ToolTip.Tip>
                                <ToolTip>
                                  <TextBlock Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink}" TextWrapping="Wrap">
                                    <Run FontFamily="{StaticResource code-font}" Text="{Binding Section}"/><Run Text="{Binding TipEnd}"/>
                                  </TextBlock>
                                </ToolTip>
                              </ToolTip.Tip>
                              <TextBlock Classes="line-text" Theme="{StaticResource type-meta}" FontFeatures="+tnum" Text="{Binding LineText}"/>
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="linelink" Classes.ring="{Binding RingOnMorePlaces}" Name="MorePlaces"
                            HorizontalAlignment="Left" Focusable="False"
                            IsVisible="{Binding ShowsMorePlaces}" Command="{Binding OpenPageCommand}"
                            AutomationProperties.Name="{Binding MorePlacesName}">
                      <TextBlock Classes="line-text" Theme="{StaticResource type-meta-strong}" Text="{Binding MorePlacesText}"/>
                    </Button>
                    <TextBlock IsVisible="{Binding ElsewhereText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Text="{Binding ElsewhereText}" Theme="{StaticResource type-meta}"
                               Foreground="{DynamicResource ink-2}" Margin="0,2,0,0" AutomationProperties.AccessibilityView="Raw"/>
                  </StackPanel>

                  <Button Grid.Column="3" Classes="linelink" Classes.ring="{Binding RingOnLine}"
                          shell:ToolTipBehavior.LineLink="True" shell:ToolTipBehavior.RowFocus="{Binding RingOnLine}"
                          Focusable="False" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-6,-2"
                          IsVisible="{Binding ShowsLine}" Command="{Binding OpenFileCommand}"
                          AutomationProperties.Name="{Binding LineSpokenName}">
                    <ToolTip.Tip>
                      <ToolTip>
                        <TextBlock Theme="{StaticResource type-meta}" Foreground="{DynamicResource ink}" TextWrapping="Wrap">
                          <Run FontFamily="{StaticResource code-font}" Text="{Binding LineSection}"/><Run Text="{Binding LineTipEnd}"/>
                        </TextBlock>
                      </ToolTip>
                    </ToolTip.Tip>
                    <TextBlock Classes="line-text" Theme="{StaticResource type-meta}" FontFeatures="+tnum" Text="{Binding LineText}"/>
                  </Button>

                  <parts:Icon Grid.Column="4" Data="{StaticResource i-right}" Width="16" Height="16" Margin="12,2,0,0"
                              VerticalAlignment="Top" Stroke="{DynamicResource ink-3}"
                              IsVisible="{Binding $parent[local:RuleListBox].IsOnePane}"/>
                </Grid>
              </DataTemplate>

            </local:RuleListBox.DataTemplates>
          </local:RuleListBox>

          <!-- The heading of the group whose rules are at the top stays in view while they scroll under it, and leaves with
               its last rule. It is drawn over the list, 44 high, on the list column's colour. -->
          <ContentControl Name="StickyHeading" IsVisible="False" VerticalAlignment="Top" Margin="8,0,24,0" Background="{DynamicResource side}"/>

          <!-- The search finds nothing: in place of the rows, 48 from the top, centred. -->
          <StackPanel IsVisible="{Binding HasNoMatch}" Margin="16,48,16,0" Spacing="12" HorizontalAlignment="Center"
                      VerticalAlignment="Top">
            <TextBlock Theme="{StaticResource type-body}" Foreground="{DynamicResource ink-2}" TextAlignment="Center"
                       Text="{Binding NoMatchText}"/>
            <Button Classes="cf quiet" HorizontalAlignment="Center" Command="{Binding ClearSearchCommand}">
              <TextBlock Theme="{StaticResource type-body-strong}" FontWeight="Medium" Text="Clear the search"/>
            </Button>
          </StackPanel>
        </Panel>
      </Grid>
    </Border>

    <!-- The page: the page of the open rule, under the title strip. Each rule's page is made when the rule is first opened and
         then only shown and hidden, so choosing another rule builds nothing. With no rule open it says so, 96 from the top. -->
    <Border Name="PagePane" Grid.Column="1" Background="{DynamicResource page}">
      <Panel Margin="0,36,0,0">
        <Panel Name="PageHost"/>
        <Panel IsVisible="{Binding ShowsNoRuleBlock}">
          <ScrollViewer IsVisible="{Binding ShowsSetup}" Padding="32,4,32,32" HorizontalScrollBarVisibility="Disabled">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="600"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SetupPage}" HorizontalContentAlignment="Stretch"/>
            </Grid>
          </ScrollViewer>
          <!-- The list has no rule to open. -->
          <StackPanel Name="NoRuleBlock" IsVisible="{Binding !ShowsSetup}" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Margin="32,32,32,0">
            <TextBlock Theme="{StaticResource type-title}" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding NoRuleHeading}"/>
            <TextBlock Theme="{StaticResource type-lead}" Foreground="{DynamicResource ink-2}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="{Binding NoRuleLead}"/>
            <Border Background="{DynamicResource well}" CornerRadius="16" Padding="20,16" HorizontalAlignment="Center" Margin="0,16,0,0"
                    AutomationProperties.Name="{Binding SpecimenSpokenName}">
              <review:SentencePieces Pieces="{Binding Specimen}" IsHitTestVisible="False"/>
            </Border>
            <TextBlock Theme="{StaticResource type-body}" Foreground="{DynamicResource ink-2}" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="0,24,0,0" IsVisible="{Binding ShowsEmptyRules}" Text="Write it with New rule, at the top of the list."/>
          </StackPanel>
        </Panel>
      </Panel>
    </Border>

  </Grid>

</UserControl>
