<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The colour tokens, one dictionary per theme. No colour is written anywhere else. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="page" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="side" Color="#F5F5F5"/>
      <SolidColorBrush x:Key="well" Color="#F7F7F7"/>
      <SolidColorBrush x:Key="hover" Color="#EBEBEB"/>
      <SolidColorBrush x:Key="line" Color="#E4E4E4"/>
      <SolidColorBrush x:Key="line-strong" Color="#CDCDCD"/>
      <SolidColorBrush x:Key="data" Color="#8C8C8C"/>
      <SolidColorBrush x:Key="ink" Color="#1C1C1C"/>
      <SolidColorBrush x:Key="ink-2" Color="#3A3A3A"/>
      <SolidColorBrush x:Key="ink-3" Color="#525252"/>
      <SolidColorBrush x:Key="ink-disabled" Color="#8A8A8A"/>
      <SolidColorBrush x:Key="solid" Color="#1C1C1C"/>
      <SolidColorBrush x:Key="solid-hover" Color="#3A3A3A"/>
      <SolidColorBrush x:Key="on-solid" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="shadow" Color="#D0D0D0"/>
      <SolidColorBrush x:Key="focus" Color="#1C1C1C"/>
      <SolidColorBrush x:Key="focus-gap" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="here" Color="#2450E6"/>
      <SolidColorBrush x:Key="on-here" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="on" Color="#1C1C1C"/>
      <SolidColorBrush x:Key="on-knob" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="off" Color="#767676"/>
      <SolidColorBrush x:Key="off-track" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="logo-tile" Color="#1C1C1C"/>
      <SolidColorBrush x:Key="logo-for" Color="#B9A3FF"/>
      <SolidColorBrush x:Key="logo-where" Color="#8FD3FF"/>
      <SolidColorBrush x:Key="logo-req" Color="#7FDDB0"/>
      <SolidColorBrush x:Key="logo-rail" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="for" Color="#E6DCFF"/>
      <SolidColorBrush x:Key="for-ink" Color="#4B22B8"/>
      <SolidColorBrush x:Key="where" Color="#CFECFF"/>
      <SolidColorBrush x:Key="where-ink" Color="#0B5884"/>
      <SolidColorBrush x:Key="req" Color="#CFF3E0"/>
      <SolidColorBrush x:Key="req-ink" Color="#0F6640"/>
      <SolidColorBrush x:Key="forbid" Color="#FFDDD0"/>
      <SolidColorBrush x:Key="forbid-ink" Color="#A02E17"/>
      <SolidColorBrush x:Key="block" Color="#D42B38"/>
      <SolidColorBrush x:Key="on-block" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="block-ink" Color="#A51C24"/>
      <SolidColorBrush x:Key="block-tint" Color="#FFDAD6"/>
      <SolidColorBrush x:Key="warn" Color="#F0A000"/>
      <SolidColorBrush x:Key="on-warn" Color="#1C1C1C"/>
      <SolidColorBrush x:Key="warn-tint" Color="#FFF1C2"/>
      <SolidColorBrush x:Key="code-keyword" Color="#8E24AA"/>
      <SolidColorBrush x:Key="code-type" Color="#0A6577"/>
      <SolidColorBrush x:Key="code-string" Color="#B3401A"/>
      <SolidColorBrush x:Key="code-comment" Color="#5E6B5E"/>
      <SolidColorBrush x:Key="code-number" Color="#7A5200"/>
      <SolidColorBrush x:Key="diff-del" Color="#FFECEA"/>
      <SolidColorBrush x:Key="diff-del-mark" Color="#FAC5C0"/>
      <SolidColorBrush x:Key="diff-add" Color="#E3F5E9"/>
      <SolidColorBrush x:Key="diff-add-mark" Color="#B5E5C5"/>
      <BoxShadows x:Key="shadow-raised">0 1 3 0 #D0D0D0</BoxShadows>
      <BoxShadows x:Key="shadow-popup">0 2 6 0 #D0D0D0</BoxShadows>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="page" Color="#262626"/>
      <SolidColorBrush x:Key="side" Color="#202020"/>
      <SolidColorBrush x:Key="well" Color="#2E2E2E"/>
      <SolidColorBrush x:Key="hover" Color="#353535"/>
      <SolidColorBrush x:Key="line" Color="#3A3A3A"/>
      <SolidColorBrush x:Key="line-strong" Color="#555555"/>
      <SolidColorBrush x:Key="data" Color="#7E7E7E"/>
      <SolidColorBrush x:Key="ink" Color="#EDEDED"/>
      <SolidColorBrush x:Key="ink-2" Color="#C8C8C8"/>
      <SolidColorBrush x:Key="ink-3" Color="#B0B0B0"/>
      <SolidColorBrush x:Key="ink-disabled" Color="#7A7A7A"/>
      <SolidColorBrush x:Key="solid" Color="#EDEDED"/>
      <SolidColorBrush x:Key="solid-hover" Color="#D6D6D6"/>
      <SolidColorBrush x:Key="on-solid" Color="#1F1F1F"/>
      <SolidColorBrush x:Key="shadow" Color="#1A1A1A"/>
      <SolidColorBrush x:Key="focus" Color="#EDEDED"/>
      <SolidColorBrush x:Key="focus-gap" Color="#1F1F1F"/>
      <SolidColorBrush x:Key="here" Color="#8FA8FF"/>
      <SolidColorBrush x:Key="on-here" Color="#1F1F1F"/>
      <SolidColorBrush x:Key="on" Color="#EDEDED"/>
      <SolidColorBrush x:Key="on-knob" Color="#1F1F1F"/>
      <SolidColorBrush x:Key="off" Color="#8C8C8C"/>
      <SolidColorBrush x:Key="off-track" Color="#262626"/>
      <SolidColorBrush x:Key="logo-tile" Color="#3A3A3A"/>
      <SolidColorBrush x:Key="logo-for" Color="#B9A3FF"/>
      <SolidColorBrush x:Key="logo-where" Color="#8FD3FF"/>
      <SolidColorBrush x:Key="logo-req" Color="#7FDDB0"/>
      <SolidColorBrush x:Key="logo-rail" Color="#EDEDED"/>
      <SolidColorBrush x:Key="for" Color="#44298F"/>
      <SolidColorBrush x:Key="for-ink" Color="#DDD3FF"/>
      <SolidColorBrush x:Key="where" Color="#1E4257"/>
      <SolidColorBrush x:Key="where-ink" Color="#AEE0FA"/>
      <SolidColorBrush x:Key="req" Color="#1F4A37"/>
      <SolidColorBrush x:Key="req-ink" Color="#A6E5C5"/>
      <SolidColorBrush x:Key="forbid" Color="#5A2C20"/>
      <SolidColorBrush x:Key="forbid-ink" Color="#FFC6B3"/>
      <SolidColorBrush x:Key="block" Color="#D13B40"/>
      <SolidColorBrush x:Key="on-block" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="block-ink" Color="#FFB8B3"/>
      <SolidColorBrush x:Key="block-tint" Color="#55262A"/>
      <SolidColorBrush x:Key="warn" Color="#E8A317"/>
      <SolidColorBrush x:Key="on-warn" Color="#1C1C1C"/>
      <SolidColorBrush x:Key="warn-tint" Color="#4D3D10"/>
      <SolidColorBrush x:Key="code-keyword" Color="#DDAAF5"/>
      <SolidColorBrush x:Key="code-type" Color="#6FCBDD"/>
      <SolidColorBrush x:Key="code-string" Color="#F2A07E"/>
      <SolidColorBrush x:Key="code-comment" Color="#8FA38F"/>
      <SolidColorBrush x:Key="code-number" Color="#E5C07B"/>
      <SolidColorBrush x:Key="diff-del" Color="#3F2A2A"/>
      <SolidColorBrush x:Key="diff-del-mark" Color="#5E3030"/>
      <SolidColorBrush x:Key="diff-add" Color="#26392D"/>
      <SolidColorBrush x:Key="diff-add-mark" Color="#2A4F38"/>
      <BoxShadows x:Key="shadow-raised">0 1 3 0 #1A1A1A</BoxShadows>
      <BoxShadows x:Key="shadow-popup">0 2 6 0 #1A1A1A</BoxShadows>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
