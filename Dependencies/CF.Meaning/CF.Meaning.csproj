<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- a compiler loads this file: it targets netstandard2.0 and the oldest compiler the team may use (Roslyn 4.8, the compiler of the .NET 8 SDK); a newer compiler loads it too -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>$(NoWarn);RS2008;RS1038</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- the tests reach the internal types -->
    <InternalsVisibleTo Include="CF.Tests" />
  </ItemGroup>

</Project>
